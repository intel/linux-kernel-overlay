From c3a0af7108a282b0de265765d56d2a72e4ad3f38 Mon Sep 17 00:00:00 2001
From: Kris Pan <kris.pan@intel.com>
Date: Thu, 5 Nov 2026 14:35:57 +0800
Subject: [PATCH 48/50] media: i2c: lt6911uxc: map CSI-2 endpoint ports to
 source pads

The driver exposes two source pads for split mode but does not implement
.get_fwnode_pad.  media_entity_get_fwnode_pad() therefore falls back to the
first source pad, which would link both IPU CSI-2 ports to pad 0.

The endpoint created by ipu-bridge for the second port is a software node
attached as the sensor's secondary fwnode.
v4l2_subdev_get_fwnode_pad_1_to_1() only checks device_match_fwnode(), so
it cannot match that endpoint and returns -ENXIO.

Use the same approach as the maxim-serdes driver: check the endpoint's port
parent against the device fwnode and against its secondary fwnode, and map
the endpoint port to the source pad.

Signed-off-by: Kris Pan <kris.pan@intel.com>
---
 drivers/media/i2c/lt6911uxc.c | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/drivers/media/i2c/lt6911uxc.c b/drivers/media/i2c/lt6911uxc.c
index 18475a957f71..155e0da2a6b4 100644
--- a/drivers/media/i2c/lt6911uxc.c
+++ b/drivers/media/i2c/lt6911uxc.c
@@ -505,8 +505,33 @@ static const struct v4l2_subdev_ops lt6911uxc_subdev_ops = {
 	.pad = &lt6911uxc_pad_ops,
 };
 
+static int lt6911uxc_get_fwnode_pad(struct media_entity *entity,
+				    struct fwnode_endpoint *endpoint)
+{
+	struct fwnode_handle *fwnode;
+	struct v4l2_subdev *sd;
+
+	if (!is_media_entity_v4l2_subdev(entity))
+		return -EINVAL;
+
+	sd = media_entity_to_v4l2_subdev(entity);
+
+	fwnode = fwnode_graph_get_port_parent(endpoint->local_fwnode);
+
+	if (device_match_fwnode(sd->dev, fwnode) ||
+	    (sd->fwnode && sd->fwnode->secondary == fwnode)) {
+		fwnode_handle_put(fwnode);
+		return endpoint->port;
+	}
+
+	fwnode_handle_put(fwnode);
+
+	return -ENXIO;
+}
+
 static const struct media_entity_operations lt6911uxc_subdev_entity_ops = {
 	.link_validate = v4l2_subdev_link_validate,
+	.get_fwnode_pad = lt6911uxc_get_fwnode_pad,
 };
 
 static const struct v4l2_subdev_internal_ops lt6911uxc_internal_ops = {
-- 
2.34.1

