From 7ab90ee33c2b084d79cb8b8065d2592d61025e71 Mon Sep 17 00:00:00 2001
From: Saranya Gopal <saranya.gopal@intel.com>
Date: Mon, 26 Oct 2026 10:47:11 +0530
Subject: [PATCH] PM: INTERNAL: platform/x86/intel/pmc: Update NVL-H PCD LPM
 telemetry GUID

Signed-off-by: Saranya Gopal <saranya.gopal@intel.com>
(cherry picked from commit 10f898cc457f76a4be9b4baaae4e663bf95cbc69)
Signed-off-by: Pedaballi, ManikanthX Reddy <manikanthx.reddy.pedaballi@intel.com>
---
 drivers/platform/x86/intel/pmc/nvl.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/platform/x86/intel/pmc/nvl.c b/drivers/platform/x86/intel/pmc/nvl.c
index 1ed02332dbfc..b8238c3dbcd5 100644
--- a/drivers/platform/x86/intel/pmc/nvl.c
+++ b/drivers/platform/x86/intel/pmc/nvl.c
@@ -12,7 +12,7 @@
 #include "core.h"
 
 /* PMC SSRAM PMT Telemetry GUIDS */
-#define PCDH_LPM_REQ_GUID 0x01093101
+#define PCDH_LPM_REQ_GUID 0x01093102
 #define PCHS_LPM_REQ_GUID 0x01092101
 #define PCDS_LPM_REQ_GUID 0x01091103
 
-- 
2.43.0

