From bfd504b304e0fa27e6e1b4cf51cf6eb8237a0bd7 Mon Sep 17 00:00:00 2001
From: linya14x <linx.yang@intel.com>
Date: Tue, 21 Apr 2026 14:33:42 +0800
Subject: [PATCH 13/47] media: pci: enable lt6911gxd in ipu-bridge

- Changes from ipu7-drivers for PTL MR2

Signed-off-by: linya14x <linx.yang@intel.com>
---
 drivers/media/pci/intel/ipu-bridge.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/media/pci/intel/ipu-bridge.c b/drivers/media/pci/intel/ipu-bridge.c
index 8c68e8ca9c05..2950640217ce 100644
--- a/drivers/media/pci/intel/ipu-bridge.c
+++ b/drivers/media/pci/intel/ipu-bridge.c
@@ -81,6 +81,8 @@ static const struct ipu_sensor_config ipu_supported_sensors[] = {
 	IPU_SENSOR_CONFIG("INTC10C5", 0),
 	/* Lontium LT6911UXC */
 	IPU_SENSOR_CONFIG("INTC10B1", 0),
+	/* Lontium lt6911gxd */
+	IPU_SENSOR_CONFIG("INTC1124", 0),
 	/* Omnivision OV01A10 / OV01A1S */
 	IPU_SENSOR_CONFIG("OVTI01A0", 1, 400000000),
 	IPU_SENSOR_CONFIG("OVTI01AS", 1, 400000000),
@@ -103,8 +105,6 @@ static const struct ipu_sensor_config ipu_supported_sensors[] = {
 	IPU_SENSOR_CONFIG("XMCC0003", 1, 321468000),
 	/* OnSemiconductor AR0234 */
 	IPU_SENSOR_CONFIG("INTC10C0", 1, 360000000),
-	/* Lontium lt6911gxd */
-	IPU_SENSOR_CONFIG("INTC1124", 0),
 	/* D3 Embedded ISX031 */
 	IPU_SENSOR_CONFIG("INTC113C", 1, 300000000),
 	/* LI AR0830 */
-- 
2.34.1

