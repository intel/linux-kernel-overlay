From 6227180a2388e56bbf0c966aba2348b58bfdaa8b Mon Sep 17 00:00:00 2001
From: syafiqnizam25 <muhammadsyafiqnizamuddinx.binshafie@intel.com>
Date: Thu, 24 Sep 2026 09:50:59 +0800
Subject: [PATCH] ipu: driver: media: re-enable Kconfig

- enable back ipu3, ipu6, ivsc in Kconfig and Makefile

Signed-off-by: syafiqnizam25 <muhammadsyafiqnizamuddinx.binshafie@intel.com>
---
 drivers/media/pci/intel/Kconfig  | 5 +++++
 drivers/media/pci/intel/Makefile | 3 +++
 2 files changed, 8 insertions(+)

diff --git a/drivers/media/pci/intel/Kconfig b/drivers/media/pci/intel/Kconfig
index 78ce495d1fd1..64b6ba30bdbc 100644
--- a/drivers/media/pci/intel/Kconfig
+++ b/drivers/media/pci/intel/Kconfig
@@ -1,4 +1,9 @@
 # SPDX-License-Identifier: GPL-2.0-only
+
+source "drivers/media/pci/intel/ipu3/Kconfig"
+source "drivers/media/pci/intel/ipu6/Kconfig"
+source "drivers/media/pci/intel/ivsc/Kconfig"
+
 config IPU_BRIDGE
 	tristate "Intel IPU Bridge"
 	depends on ACPI || COMPILE_TEST
diff --git a/drivers/media/pci/intel/Makefile b/drivers/media/pci/intel/Makefile
index bcd17332a6dd..bc8adeb16dac 100644
--- a/drivers/media/pci/intel/Makefile
+++ b/drivers/media/pci/intel/Makefile
@@ -3,3 +3,6 @@
 # Makefile for the IPU drivers
 #
 obj-$(CONFIG_IPU_BRIDGE) += ipu-bridge.o
+obj-y	+= ipu3/
+obj-y	+= ivsc/
+obj-$(CONFIG_VIDEO_INTEL_IPU6)	+= ipu6/
\ No newline at end of file
-- 
2.34.1

