From 12fb5c1402236dd169b0b376c4f73a5c58b6ec90 Mon Sep 17 00:00:00 2001
From: Hao Yao <hao.yao@intel.com>
Date: Wed, 23 Sep 2026 15:29:47 +0800
Subject: [PATCH 02/47] IPU6 release for iot on 2026-09-23

- Changes from ipu6-drivers for ARL MR5

Signed-off-by: Hao Yao <hao.yao@intel.com>
---
 drivers/media/i2c/lt6911uxc.c                | 15 +++------------
 drivers/media/pci/intel/ipu6/psys/ipu-psys.c |  6 ++++--
 2 files changed, 7 insertions(+), 14 deletions(-)

diff --git a/drivers/media/i2c/lt6911uxc.c b/drivers/media/i2c/lt6911uxc.c
index c0ceb1d99c76..18475a957f71 100644
--- a/drivers/media/i2c/lt6911uxc.c
+++ b/drivers/media/i2c/lt6911uxc.c
@@ -1,5 +1,5 @@
 // SPDX-License-Identifier: GPL-2.0
-// Copyright (c) 2022-2025 Intel Corporation.
+// Copyright (c) 2022-2026 Intel Corporation.
 
 #include <linux/acpi.h>
 #include <linux/delay.h>
@@ -45,7 +45,6 @@
 #define INT_HDMI_DISCONNECT		0x88
 #define INT_HDMI_STABLE		0x55
 
-
 #define REG_INT_AUDIO		CCI_REG8(0x86A5)
 #define INT_AUDIO_SR_HIGH	CCI_REG8(0x55)
 #define INT_AUDIO_SR_LOW	CCI_REG8(0xAA)
@@ -107,7 +106,6 @@ struct lt6911uxc {
 	unsigned int irq_pin_flags;
 	struct gpio_desc *reset_gpio;
 	struct gpio_desc *irq_gpio;
-	struct gpio_desc *detect_gpio;
 
 	bool auxiliary_port;
 };
@@ -239,7 +237,6 @@ static int lt6911uxc_status_update(struct lt6911uxc *lt6911uxc)
 		lt6911uxc->cur_mode->lanes = lanes;
 		lt6911uxc->cur_mode->link_freq = byte_clock;
 
-
 		if (lt6911uxc->cur_mode->lanes == 8) {
 			/* 4K60fps with 2 MIPI ports*/
 			if (lt6911uxc->cur_mode->width >= 3840)
@@ -560,16 +557,10 @@ static int lt6911uxc_parse_gpio(struct lt6911uxc *lt6911uxc, struct device *dev)
 				     "failed to get reset gpio\n");
 	}
 
-	lt6911uxc->irq_gpio = devm_gpiod_get(dev, "readystat", GPIOD_IN);
+	lt6911uxc->irq_gpio = devm_gpiod_get(dev, "hpd", GPIOD_IN);
 	if (IS_ERR(lt6911uxc->irq_gpio))
 		return dev_err_probe(dev, PTR_ERR(lt6911uxc->irq_gpio),
-				     "failed to get ready_stat gpio\n");
-
-	lt6911uxc->detect_gpio = devm_gpiod_get(dev, "hdmidetect",
-						GPIOD_OUT_HIGH);
-	if (IS_ERR(lt6911uxc->detect_gpio))
-		return dev_err_probe(dev, PTR_ERR(lt6911uxc->detect_gpio),
-				     "failed to get hdmi_detect gpio\n");
+				     "failed to get hpd gpio\n");
 
 	return 0;
 }
diff --git a/drivers/media/pci/intel/ipu6/psys/ipu-psys.c b/drivers/media/pci/intel/ipu6/psys/ipu-psys.c
index 64232388008f..632478256152 100644
--- a/drivers/media/pci/intel/ipu6/psys/ipu-psys.c
+++ b/drivers/media/pci/intel/ipu6/psys/ipu-psys.c
@@ -512,8 +512,10 @@ static int ipu_psys_get_userpages(struct ipu_dma_buf_attach *attach)
 	flags = FOLL_WRITE | FOLL_FORCE | FOLL_LONGTERM;
 	nr = pin_user_pages_fast(start & PAGE_MASK, npages,
 				 flags, pages);
-	if (nr < npages)
+	if (nr < npages) {
+		ret = nr < 0 ? nr : -EFAULT;
 		goto error;
+	}
 
 	attach->pages = pages;
 	attach->npages = npages;
@@ -531,7 +533,7 @@ static int ipu_psys_get_userpages(struct ipu_dma_buf_attach *attach)
 error_up_read:
 	mmap_read_unlock(current->mm);
 error:
-	if (nr)
+	if (nr > 0)
 		unpin_user_pages(pages, nr);
 	kvfree(pages);
 free_sgt:
-- 
2.34.1

