From 90fd04099cb8fc0c53e92644ef4561a69c6b194b Mon Sep 17 00:00:00 2001
From: "Lui, Jonathan" <jonathan.ming.jun.lui@intel.com>
Date: Mon, 5 Oct 2026 10:26:28 +0800
Subject: [PATCH 06/17] media: i2c: ar0234: Add ret check when setting dir

Adding ret check in the event the setting fails.

Signed-off-by: Lui, Jonathan <jonathan.ming.jun.lui@intel.com>
---
 drivers/media/i2c/ar0234.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/media/i2c/ar0234.c b/drivers/media/i2c/ar0234.c
index c5acb415dc20..ecec808722e5 100644
--- a/drivers/media/i2c/ar0234.c
+++ b/drivers/media/i2c/ar0234.c
@@ -1207,7 +1207,13 @@ static int __maybe_unused ar0234_resume(struct device *dev)
 	mutex_lock(&ar0234_mutex);
 
 	if (ar0234->reset_gpio) {
-		gpiod_direction_output(ar0234->reset_gpio, 0);
+		ret = gpiod_direction_output(ar0234->reset_gpio, 0);
+		if (ret) {
+			dev_err(&client->dev,
+				"failed to set reset GPIO direction: %d\n", ret);
+			mutex_unlock(&ar0234_mutex);
+			return ret;
+		}
 
 		for (count = 0; count < AR0234_PM_MAX_RETRY; count++) {
 			gpiod_set_value_cansleep(ar0234->reset_gpio, 0);
-- 
2.43.0

