From a348c41878da8e07f3caa8e1cca02676cdb7037d Mon Sep 17 00:00:00 2001
From: linya14x <linx.yang@intel.com>
Date: Tue, 14 Apr 2026 17:11:10 +0800
Subject: [PATCH 07/47] Refine PDATA related config

- Changes from ipu6-drivers for ARL MR5

Signed-off-by: linya14x <linx.yang@intel.com>
---
 drivers/media/pci/intel/ipu6/ipu6-isys.h | 2 ++
 drivers/media/pci/intel/ipu6/ipu6.c      | 9 +++++----
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/drivers/media/pci/intel/ipu6/ipu6-isys.h b/drivers/media/pci/intel/ipu6/ipu6-isys.h
index 1054a4566a3a..f9d7497386f9 100644
--- a/drivers/media/pci/intel/ipu6/ipu6-isys.h
+++ b/drivers/media/pci/intel/ipu6/ipu6-isys.h
@@ -211,7 +211,9 @@ struct ipu_isys_subdev_info {
 };
 
 struct ipu_isys_clk_mapping {
+#if IS_ENABLED(CONFIG_INTEL_IPU_ACPI)
 	struct clk_lookup clkdev_data;
+#endif
 	char *platform_clock_name;
 };
 
diff --git a/drivers/media/pci/intel/ipu6/ipu6.c b/drivers/media/pci/intel/ipu6/ipu6.c
index 8fe0b3c0a3e9..bbb49270e735 100644
--- a/drivers/media/pci/intel/ipu6/ipu6.c
+++ b/drivers/media/pci/intel/ipu6/ipu6.c
@@ -394,9 +394,9 @@ static void ipu6_internal_pdata_init(struct ipu6_device *isp)
 static struct ipu6_bus_device *
 ipu6_isys_init(struct pci_dev *pdev, struct device *parent,
 	       struct ipu6_buttress_ctrl *ctrl, void __iomem *base,
-	       const struct ipu6_isys_internal_pdata *ipdata,
+	       const struct ipu6_isys_internal_pdata *ipdata
 #if IS_ENABLED(CONFIG_INTEL_IPU_ACPI)
-	       struct ipu_isys_subdev_pdata *spdata
+	       , struct ipu_isys_subdev_pdata *spdata
 #endif
 			)
 {
@@ -455,6 +455,7 @@ ipu6_isys_init(struct pci_dev *pdev, struct device *parent,
 	if (ret)
 		return ERR_PTR(ret);
 #endif
+
 	isys_adev->mmu = ipu6_mmu_init(dev, base, ISYS_MMID,
 				       &ipdata->hw_variant);
 	if (IS_ERR(isys_adev->mmu)) {
@@ -704,9 +705,9 @@ static int ipu6_pci_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 	}
 
 	isp->isys = ipu6_isys_init(pdev, dev, isys_ctrl, isys_base,
-				   &isys_ipdata,
+				   &isys_ipdata
 #if IS_ENABLED(CONFIG_INTEL_IPU_ACPI)
-				  pdev->dev.platform_data
+				  , pdev->dev.platform_data
 #endif
 					);
 	if (IS_ERR(isp->isys)) {
-- 
2.34.1

