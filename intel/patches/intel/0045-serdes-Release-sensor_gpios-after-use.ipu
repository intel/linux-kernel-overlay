From 7af60b139277ceefce05eef57a7406182172e6b0 Mon Sep 17 00:00:00 2001
From: "Khai Wen, Ng" <khai.wen.ng@intel.com>
Date: Wed, 10 Jun 2026 10:00:00 +0800
Subject: [PATCH 45/73] serdes: Release sensor_gpios after use

Signed-off-by: Khai Wen, Ng <khai.wen.ng@intel.com>
---
 drivers/media/i2c/max9x/serdes.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/media/i2c/max9x/serdes.c b/drivers/media/i2c/max9x/serdes.c
index 1cf19c818eac..bb6def4ddba1 100644
--- a/drivers/media/i2c/max9x/serdes.c
+++ b/drivers/media/i2c/max9x/serdes.c
@@ -1911,6 +1911,7 @@ static int max9x_registered(struct v4l2_subdev *sd)
 									  &subdev_pdata->board_info, NULL);
 
 					gpiod_remove_lookup_table(sensor_gpios);
+					devm_kfree(dev, sensor_gpios);
 
 					if (IS_ERR_OR_NULL(subdev)) {
 						dev_err(dev,
-- 
2.34.1

