From 0a0c7b8a3461f448e0542ab33ece085903706695 Mon Sep 17 00:00:00 2001
From: "Khai Wen, Ng" <khai.wen.ng@intel.com>
Date: Mon, 12 Oct 2026 16:43:34 +0800
Subject: [PATCH 11/17] d4xx: Increase timeout to 3 seconds

There are still some corner cases where firmware takes
more than 2 seconds to finally start sending out data.

Extend to 3 seconds instead.

Signed-off-by: Khai Wen, Ng <khai.wen.ng@intel.com>
---
 drivers/media/i2c/d4xx.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/media/i2c/d4xx.c b/drivers/media/i2c/d4xx.c
index e6e02289dd31..51ca358028a2 100644
--- a/drivers/media/i2c/d4xx.c
+++ b/drivers/media/i2c/d4xx.c
@@ -139,7 +139,7 @@
 #define DS5_START_POLL_TIME	10
 #define DS5_START_MAX_TIME	1000
 #define DS5_START_MAX_COUNT	(DS5_START_MAX_TIME / DS5_START_POLL_TIME)
-#define DS5_STREAM_START_TIMEOUT	2000
+#define DS5_STREAM_START_TIMEOUT	3000
 #define DFU_MAGIC_NUMBER "/0x01/0x02/0x03/0x04"
 #define DFU_BLOCK_SIZE 1024
 #define DS5_FRAMERATE_DEFAULT_IDX 1
-- 
2.43.0

