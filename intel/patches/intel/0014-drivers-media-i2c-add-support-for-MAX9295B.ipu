From 7382a23e34e511d35b1bb2d7352711680b1a5c62 Mon Sep 17 00:00:00 2001
From: "Khai Wen, Ng" <khai.wen.ng@intel.com>
Date: Mon, 3 Aug 2026 14:31:53 +0800
Subject: [PATCH 14/17] drivers: media: i2c: add support for MAX9295B

MAX9295B need additional reset and PHY configuration.
MAX9295A only supports 1X4, and set MAX9295B to support 1X4
as well. The reset and PHY configuration will not impact existing
MAX9295A operations.

Signed-off-by: Khai Wen, Ng <khai.wen.ng@intel.com>
---
 drivers/media/i2c/maxim-serdes/max96717.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/drivers/media/i2c/maxim-serdes/max96717.c b/drivers/media/i2c/maxim-serdes/max96717.c
index b9eacceff303..605e3ffa8af2 100644
--- a/drivers/media/i2c/maxim-serdes/max96717.c
+++ b/drivers/media/i2c/maxim-serdes/max96717.c
@@ -149,10 +149,12 @@
 
 #define MAX96717_MIPI_RX0			0x330
 #define MAX96717_MIPI_RX0_NONCONTCLK_EN		BIT(6)
+#define MAX96717_MIPI_RX0_RESET				BIT(3)
 #define MAX96717_MIPI_RX0_PHY_CFG			GENMASK(2, 0)
 #define MAX96717_MIPI_RX0_PHY_CFG_A_ONLY	0b100
 #define MAX96717_MIPI_RX0_PHY_CFG_B_ONLY	0b101
 #define MAX96717_MIPI_RX0_PHY_CFG_A_AND_B	0b110
+#define MAX96717_MIPI_RX0_PHY_CFG_1x4		0b000
 
 #define MAX96717_MIPI_RX1			0x331
 #define MAX96717_MIPI_RX1_CTRL1_NUM_LANES	GENMASK(5, 4)
@@ -1512,6 +1514,20 @@ static int max96717_init(struct max_ser *ser)
 							MAX96717_MIPI_RX0_PHY_CFG_A_AND_B));
 		if (ret)
 			return ret;
+	} else if (priv->info->num_phys == 1) {
+		ret = regmap_update_bits(priv->regmap, MAX96717_MIPI_RX0,
+					MAX96717_MIPI_RX0_RESET,
+					FIELD_PREP(MAX96717_MIPI_RX0_RESET, 1));
+		if (ret)
+			return ret;
+
+		ret = regmap_update_bits(priv->regmap, MAX96717_MIPI_RX0,
+				MAX96717_MIPI_RX0_RESET | MAX96717_MIPI_RX0_PHY_CFG,
+				FIELD_PREP(MAX96717_MIPI_RX0_RESET, 0) |
+				FIELD_PREP(MAX96717_MIPI_RX0_PHY_CFG,
+					MAX96717_MIPI_RX0_PHY_CFG_1x4));
+		if (ret)
+			return ret;
 	}
 
 	if (ser->ops->set_tunnel_enable) {
-- 
2.43.0

