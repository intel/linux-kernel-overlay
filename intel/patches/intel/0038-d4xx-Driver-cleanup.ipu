---
 drivers/media/i2c/d4xx.c | 340 +++++----------------------------------
 1 file changed, 44 insertions(+), 296 deletions(-)

diff --git a/drivers/media/i2c/d4xx.c b/drivers/media/i2c/d4xx.c
index 1b1958ae8baa..6c6247c888d0 100644
