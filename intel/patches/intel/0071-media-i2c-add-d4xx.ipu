From 38131e1f862524e81f78a96ae9daf7d22519ef25 Mon Sep 17 00:00:00 2001
From: syafiqnizam25 <muhammadsyafiqnizamuddinx.binshafie@intel.com>
Date: Mon, 24 Aug 2026 09:22:35 +0800
Subject: [PATCH 71/73] media: i2c: add d4xx

- update Kconfig
- upadte Makefile

Signed-off-by: syafiqnizam25 <muhammadsyafiqnizamuddinx.binshafie@intel.com>
---
 drivers/media/i2c/Kconfig  | 14 ++++++++++++++
 drivers/media/i2c/Makefile |  1 +
 2 files changed, 15 insertions(+)

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 526110ee126b..275768e280c9 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -1260,6 +1260,20 @@ config VIDEO_ISX031
 		To compile this driver as a module, choose M here: the
 		module will be called isx031.
 
+config VIDEO_D4XX
+	tristate "Intel RealSense D4XX support"
+	depends on VIDEO_DEV && I2C
+	depends on MEDIA_CAMERA_SUPPORT
+	select MEDIA_CONTROLLER
+	select V4L2_FWNODE
+	select VIDEO_V4L2_SUBDEV_API
+	help
+	  This is a Video4Linux2 sensor-level driver for Intel RealSense
+	  D4XX depth cameras with a MIPI CSI-2 interface.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called d4xx.
+
 config VIDEO_MAX9X
 	tristate "MAX9X serdes support"
 	depends on VIDEO_DEV && I2C
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 106fde264b22..19a23738a9d7 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -65,6 +65,7 @@ obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
 obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
 obj-$(CONFIG_VIDEO_MAX9X) += max9x/
 obj-$(CONFIG_VIDEO_ISX031) += isx031.o
+obj-$(CONFIG_VIDEO_D4XX) += d4xx.o
 obj-$(CONFIG_VIDEO_KS0127) += ks0127.o
 obj-$(CONFIG_VIDEO_LM3560) += lm3560.o
 obj-$(CONFIG_VIDEO_LM3646) += lm3646.o
-- 
2.34.1

