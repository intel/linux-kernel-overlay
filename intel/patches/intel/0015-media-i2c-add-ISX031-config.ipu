From 7fa8cf92ec823a98a8a0a62d761654b588a004d0 Mon Sep 17 00:00:00 2001
From: linya14x <linx.yang@intel.com>
Date: Sat, 25 Oct 2025 16:46:35 +0800
Subject: [PATCH 15/47] media: i2c: add ISX031 config

- Changes from ipu7-drivers for PTL MR2

Signed-off-by: hepengpx <pengpengx.he@intel.com>
Signed-off-by: linya14x <linx.yang@intel.com>
---
 drivers/media/i2c/Kconfig  | 21 ---------------------
 drivers/media/i2c/Makefile |  2 --
 2 files changed, 23 deletions(-)

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 275768e280c9..98073ae4239f 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -307,15 +307,6 @@ config VIDEO_ISX031
 	help
 		This is a Video4Linux2 sensor-level driver for ISX031 camera.
 
-config VIDEO_MAX9X
-	tristate "MAX9X serdes support"
-	depends on VIDEO_DEV && I2C
-	select VIDEO_V4L2_SUBDEV_API
-	select I2C_ATR
-	depends on MEDIA_CAMERA_SUPPORT
-	help
-		This is a Video4Linux2 sensor-level driver for MAX9X serdes.
-
 config VIDEO_MAX9271_LIB
 	tristate
 
@@ -1248,18 +1239,6 @@ config VIDEO_ISL7998X
 	  Support for Intersil ISL7998x analog to MIPI-CSI2 or
 	  BT.656 decoder.
 
-config VIDEO_ISX031
-    tristate "ISX031 sensor support"
-	depends on VIDEO_DEV && I2C
-	select VIDEO_V4L2_SUBDEV_API
-	depends on MEDIA_CAMERA_SUPPORT
-	help
-		This is a Video4Linux2 sensor-level driver for
-		Sony ISX031 camera with a MIPI CSI-2 interface.
-
-		To compile this driver as a module, choose M here: the
-		module will be called isx031.
-
 config VIDEO_D4XX
 	tristate "Intel RealSense D4XX support"
 	depends on VIDEO_DEV && I2C
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 19a23738a9d7..a7b7c4b73e09 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -63,7 +63,6 @@ obj-$(CONFIG_VIDEO_IMX412) += imx412.o
 obj-$(CONFIG_VIDEO_IMX415) += imx415.o
 obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
 obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
-obj-$(CONFIG_VIDEO_MAX9X) += max9x/
 obj-$(CONFIG_VIDEO_ISX031) += isx031.o
 obj-$(CONFIG_VIDEO_D4XX) += d4xx.o
 obj-$(CONFIG_VIDEO_KS0127) += ks0127.o
@@ -171,6 +170,5 @@ obj-$(CONFIG_VIDEO_WM8739) += wm8739.o
 obj-$(CONFIG_VIDEO_WM8775) += wm8775.o
 obj-$(CONFIG_VIDEO_LT6911GXD) += lt6911gxd.o
 obj-$(CONFIG_VIDEO_MAX9X) += max9x/
-obj-$(CONFIG_VIDEO_ISX031) += isx031.o
 obj-$(CONFIG_VIDEO_MAXIM_SERDES) += maxim-serdes/
 
-- 
2.34.1

