From 3720db5e783d97abfebe873b4b32a0a224bc0408 Mon Sep 17 00:00:00 2001
From: syafiqnizam25 <muhammadsyafiqnizamuddinx.binshafie@intel.com>
Date: Mon, 28 Sep 2026 12:08:01 +0800
Subject: [PATCH 46/47] media: i2c: build lt6911uxc under
 CONFIG_VIDEO_LT6911UXC

This is not from drivers.camera.scaling.sensor, ipu7-drivers or
ipu6-drivers. It fixes a typo in ipu6-drivers patch/6.18.3/0007
"media: add support lt6911uxc and enable split mode", which added
"obj-$(CONFIG_VIDEO_LT6911UXE) += lt6911uxc.o". As a result,
CONFIG_VIDEO_LT6911UXC had no effect, and lt6911uxc was only built
when LT6911UXE was enabled. drivers.camera.scaling.sensor
drivers/media/i2c/Makefile already uses CONFIG_VIDEO_LT6911UXC.

Signed-off-by: syafiqnizam25 <muhammadsyafiqnizamuddinx.binshafie@intel.com>
---
 drivers/media/i2c/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 3545a7c0a10e..b801cdce8844 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -68,7 +68,7 @@ obj-$(CONFIG_VIDEO_D4XX) += d4xx.o
 obj-$(CONFIG_VIDEO_KS0127) += ks0127.o
 obj-$(CONFIG_VIDEO_LM3560) += lm3560.o
 obj-$(CONFIG_VIDEO_LM3646) += lm3646.o
-obj-$(CONFIG_VIDEO_LT6911UXE) += lt6911uxc.o
+obj-$(CONFIG_VIDEO_LT6911UXC) += lt6911uxc.o
 obj-$(CONFIG_VIDEO_LT6911UXE) += lt6911uxe.o
 obj-$(CONFIG_VIDEO_M52790) += m52790.o
 obj-$(CONFIG_VIDEO_MAX9271_LIB) += max9271.o
-- 
2.34.1

