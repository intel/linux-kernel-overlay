From 3df8a0638f852ed0d00af1d577bdda33260d087c Mon Sep 17 00:00:00 2001
From: syafiqnizam25 <muhammadsyafiqnizamuddinx.binshafie@intel.com>
Date: Tue, 24 Nov 2026 10:33:14 +0800
Subject: [PATCH 17/17] media: intel: remove obsolete IPU7 FPGA platform data

The FPGA PCI fixup still instantiates ipu7_isys_subdev_info and related
types that the native IPU7 driver no longer defines. Enabling
INTEL_IPU7_FPGA_PDATA therefore fails to compile when IPU7 is built in
and INTEL_IPU_ACPI is disabled, a combination not covered by the usual
allmodconfig or allyesconfig builds.

ISYS now discovers external sensors through firmware endpoints and the
IPU bridge. It does not consume the legacy sensor platform data attached
by this fixup. Remove the obsolete provider and its Kconfig and Makefile
entries rather than restoring unused structures solely to compile it.

The active IPU7 driver and IPU ACPI platform-data modules are unchanged.

Signed-off-by: syafiqnizam25 <muhammadsyafiqnizamuddinx.binshafie@intel.com>
---
 drivers/media/platform/intel/Kconfig          |  6 --
 drivers/media/platform/intel/Makefile         |  1 -
 .../media/platform/intel/ipu7-fpga-pdata.c    | 63 -------------------
 3 files changed, 70 deletions(-)
 delete mode 100644 drivers/media/platform/intel/ipu7-fpga-pdata.c

diff --git a/drivers/media/platform/intel/Kconfig b/drivers/media/platform/intel/Kconfig
index 1c92ec90f40e..4f6a70acf060 100644
--- a/drivers/media/platform/intel/Kconfig
+++ b/drivers/media/platform/intel/Kconfig
@@ -2,12 +2,6 @@
 
 comment "Intel media platform drivers"
 
-config INTEL_IPU7_FPGA_PDATA
-	bool "Intel IPU7 FPGA platform data"
-	depends on VIDEO_INTEL_IPU7=y && INTEL_IPU_ACPI=n
-	help
-	  Provide pre-ACPI platform data for IPU7 FPGA development systems.
-
 config INTEL_IPU_ACPI
 	tristate "Intel IPU ACPI camera platform data"
 	depends on I2C && ACPI && VIDEO_DEV && GPIOLIB
diff --git a/drivers/media/platform/intel/Makefile b/drivers/media/platform/intel/Makefile
index 4ec6dbbbddec..73e134a85c59 100644
--- a/drivers/media/platform/intel/Makefile
+++ b/drivers/media/platform/intel/Makefile
@@ -3,4 +3,3 @@ obj-$(CONFIG_VIDEO_PXA27x) += pxa_camera.o
 
 ccflags-y += -I$(srctree)/drivers/staging/media/ipu7
 obj-$(CONFIG_INTEL_IPU_ACPI) += ipu-acpi.o ipu-acpi-pdata.o ipu-acpi-common.o
-obj-$(CONFIG_INTEL_IPU7_FPGA_PDATA) += ipu7-fpga-pdata.o
diff --git a/drivers/media/platform/intel/ipu7-fpga-pdata.c b/drivers/media/platform/intel/ipu7-fpga-pdata.c
deleted file mode 100644
index 753e2f5c23ad..000000000000
--- a/drivers/media/platform/intel/ipu7-fpga-pdata.c
+++ /dev/null
@@ -1,63 +0,0 @@
-// SPDX-License-Identifier: GPL-2.0
-// Copyright (C) 2020 Intel Corporation
-#include <linux/i2c.h>
-#include <linux/kernel.h>
-#include <linux/pci.h>
-#include <media/v4l2-mediabus.h>
-
-#include "ipu7.h"
-#include "ipu7-isys.h"
-
-#define OV13B10_LANES		4
-#define OV13B10_2LANES		2
-#define OV13B10_I2C_ADDRESS	0x10
-
-static struct ipu7_isys_csi2_config ov13b10_csi2_cfg_0 = {
-	.nlanes = OV13B10_LANES,
-	.port = 0,
-	.bus_type = V4L2_MBUS_CSI2_DPHY,
-};
-
-static struct ipu7_isys_subdev_info ov13b10_sd_0 = {
-	.csi2 = &ov13b10_csi2_cfg_0,
-	.i2c = {
-	.board_info = {
-		I2C_BOARD_INFO("ov13b10", OV13B10_I2C_ADDRESS),
-	},
-	.i2c_adapter_id = 0,
-	}
-};
-
-static struct ipu7_isys_csi2_config ov13b10_csi2_cfg_1 = {
-	.nlanes = OV13B10_2LANES,
-	.port = 2,
-	.bus_type = V4L2_MBUS_CSI2_DPHY,
-};
-
-static struct ipu7_isys_subdev_info ov13b10_sd_1 = {
-	.csi2 = &ov13b10_csi2_cfg_1,
-	.i2c = {
-	.board_info = {
-		I2C_BOARD_INFO("ov13b10", OV13B10_I2C_ADDRESS),
-	},
-	.i2c_adapter_id = 1,
-	}
-};
-
-static struct ipu7_isys_subdev_pdata pdata = {
-	.subdevs = (struct ipu7_isys_subdev_info *[]) {
-		&ov13b10_sd_0,
-		&ov13b10_sd_1,
-		NULL,
-	},
-};
-
-static void ipu7_quirk(struct pci_dev *pci_dev)
-{
-	dev_info(&pci_dev->dev, "%s() attach the platform data", __func__);
-	pci_dev->dev.platform_data = &pdata;
-}
-
-DECLARE_PCI_FIXUP_EARLY(PCI_VENDOR_ID_INTEL, IPU7_PCI_ID, ipu7_quirk);
-DECLARE_PCI_FIXUP_EARLY(PCI_VENDOR_ID_INTEL, IPU7P5_PCI_ID, ipu7_quirk);
-DECLARE_PCI_FIXUP_EARLY(PCI_VENDOR_ID_INTEL, IPU8_PCI_ID, ipu7_quirk);
-- 
2.43.0

