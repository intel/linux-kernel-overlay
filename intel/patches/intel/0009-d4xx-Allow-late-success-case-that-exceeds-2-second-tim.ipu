From 45691eb0845f585e2e999052d9ada5126adce2e3 Mon Sep 17 00:00:00 2001
From: "Khai Wen, Ng" <khai.wen.ng@intel.com>
Date: Mon, 12 Oct 2026 11:11:20 +0800
Subject: [PATCH 09/17] d4xx: Allow late success case that exceeds 2 second
 time frame

There could be a late success case that exceeds 2 second time.
Make sure the case is included as success.

Signed-off-by: Khai Wen, Ng <khai.wen.ng@intel.com>
---
 drivers/media/i2c/d4xx.c | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/drivers/media/i2c/d4xx.c b/drivers/media/i2c/d4xx.c
index 2342a3cd5060..ad35124fe6d2 100644
--- a/drivers/media/i2c/d4xx.c
+++ b/drivers/media/i2c/d4xx.c
@@ -2592,7 +2592,7 @@ static int ds5_sensor_set_stream(struct v4l2_subdev *sd, u64 streams_mask, int e
 	struct ds5_sensor *sensor = container_of(sd, struct ds5_sensor, sd);
 	unsigned long start, timeout;
 	bool started = false;
-	int ret, vc_id, i;
+	int ret, stream_ret, config_ret, vc_id, i;
 	int restore_val;
 	u16 streaming, status;
 	u16 stream_status_base;
@@ -2671,8 +2671,15 @@ static int ds5_sensor_set_stream(struct v4l2_subdev *sd, u64 streams_mask, int e
 		}
 
 		if (!started) {
-			ds5_read(state, stream_status_base, &streaming);
-			ds5_read(state, config_status_base, &status);
+			stream_ret = ds5_read(state, stream_status_base, &streaming);
+			config_ret = ds5_read(state, config_status_base, &status);
+			if (stream_ret >= 0 && config_ret >= 0 &&
+			    streaming == DS5_STREAM_STREAMING &&
+			    (status & DS5_STATUS_STREAMING))
+				started = true;
+		}
+
+		if (!started) {
 			dev_err(&state->client->dev,
 				"%s start streaming timed out after %ums, retries %d, stream status 0x%04x, config status 0x%04x\n",
 				__func__, jiffies_to_msecs(jiffies - start), i,
-- 
2.43.0

