+	{ MAX9296A_RLMS7F(0), 0x68 },
+	{ MAX9296A_RLMSA3(0), 0x30 },
+	{ MAX9296A_RLMSA5(0), 0x70 },
+	{ MAX9296A_RLMSD8(0), 0x07 },
+};
