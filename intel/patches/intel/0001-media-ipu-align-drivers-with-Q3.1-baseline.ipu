 		return MIPI_CSI2_DT_RGB888;
 	case MEDIA_BUS_FMT_YUYV10_1X20:
 		return MIPI_CSI2_DT_YUV422_10B;
+	case MEDIA_BUS_FMT_VYUY8_1X16:  /* D4XX specific */
+		return MIPI_CSI2_DT_YUV422_8B;
 	case MEDIA_BUS_FMT_UYVY8_1X16:
