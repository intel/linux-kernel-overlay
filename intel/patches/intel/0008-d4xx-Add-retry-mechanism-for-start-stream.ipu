From af27126c863bf393b48e2c49ff453853e8c9dc2c Mon Sep 17 00:00:00 2001
From: "Khai Wen, Ng" <khai.wen.ng@intel.com>
Date: Sat, 10 Oct 2026 23:39:52 +0800
Subject: [PATCH 08/17] d4xx: Add retry mechanism for start stream

In situation where register for start stream already updated,
but firmware still does not provide stream, rewrite the register
to start stream again.

Instead of fixed polling every 10ms, increase the poll time
to reduce the repeated i2c traffic if firmware is slow or stuck.

Limits the total attempts to 20 times within 2 seconds.

Signed-off-by: Khai Wen, Ng <khai.wen.ng@intel.com>
---
 drivers/media/i2c/d4xx.c | 60 ++++++++++++++++++++++++++++------------
 1 file changed, 43 insertions(+), 17 deletions(-)

diff --git a/drivers/media/i2c/d4xx.c b/drivers/media/i2c/d4xx.c
index 231ba0c2d871..2342a3cd5060 100644
--- a/drivers/media/i2c/d4xx.c
+++ b/drivers/media/i2c/d4xx.c
@@ -4,6 +4,7 @@
 #include <linux/acpi.h>
 #include <linux/delay.h>
 #include <linux/i2c.h>
+#include <linux/jiffies.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
 #include <linux/gpio.h>
@@ -138,6 +139,7 @@
 #define DS5_START_POLL_TIME	10
 #define DS5_START_MAX_TIME	1000
 #define DS5_START_MAX_COUNT	(DS5_START_MAX_TIME / DS5_START_POLL_TIME)
+#define DS5_STREAM_START_TIMEOUT	2000
 #define DFU_MAGIC_NUMBER "/0x01/0x02/0x03/0x04"
 #define DFU_BLOCK_SIZE 1024
 #define DS5_FRAMERATE_DEFAULT_IDX 1
@@ -2588,6 +2590,8 @@ static int ds5_sensor_set_stream(struct v4l2_subdev *sd, u64 streams_mask, int e
 {
 	struct ds5 *state = container_of(sd, struct ds5, mux.sd.subdev);
 	struct ds5_sensor *sensor = container_of(sd, struct ds5_sensor, sd);
+	unsigned long start, timeout;
+	bool started = false;
 	int ret, vc_id, i;
 	int restore_val;
 	u16 streaming, status;
@@ -2629,36 +2633,58 @@ static int ds5_sensor_set_stream(struct v4l2_subdev *sd, u64 streams_mask, int e
 		dev_dbg(&state->client->dev, "%s: starting stream with VC %d. reg %x val %x\n",
 			__func__, vc_id, DS5_START_STOP_STREAM, DS5_STREAM_START | sensor->stream_cfg.stream_id);
 
-		ret = ds5_write(state, DS5_START_STOP_STREAM, DS5_STREAM_START | sensor->stream_cfg.stream_id);
-		if (ret < 0) {
-			dev_err(&state->client->dev, "%s: ds5 write DS5_STREAM_START failed\n", __func__);
-			goto restore_s_state;
-		}
+		// check streaming status from FW
+		streaming = DS5_STREAM_IDLE;
+		start = jiffies;
+		for (timeout = start + msecs_to_jiffies(DS5_STREAM_START_TIMEOUT), i = 0;
+		     time_before(jiffies, timeout);
+		     i++, msleep_range(i * DS5_START_POLL_TIME)) {
+			if (streaming != DS5_STREAM_STREAMING) {
+				ret = ds5_write(state, DS5_START_STOP_STREAM,
+						DS5_STREAM_START |
+							sensor->stream_cfg.stream_id);
+				if (ret < 0)
+					dev_warn(&state->client->dev,
+						 "%s: STREAM_START retry %d failed\n",
+						 __func__, i);
+			}
 
-		msleep(200);
+			ret = ds5_read(state, stream_status_base, &streaming);
+			if (ret < 0)
+				dev_warn(&state->client->dev,
+					 "%s: stream status read failed, retry %d\n",
+					 __func__, i);
 
-		// check streaming status from FW
-		for (i = 0; i < DS5_START_MAX_COUNT; i++) {
-			ds5_read(state, stream_status_base, &streaming);
-			ds5_read(state, config_status_base, &status);
-			if ((status & DS5_STATUS_STREAMING) &&
-					streaming == DS5_STREAM_STREAMING)
+			if (streaming != DS5_STREAM_STREAMING)
+				continue;
+
+			ret = ds5_read(state, config_status_base, &status);
+			if (ret >= 0 && (status & DS5_STATUS_STREAMING)) {
+				started = true;
 				break;
+			}
 
-			msleep_range(DS5_START_POLL_TIME);
+			if (ret < 0)
+				dev_warn(&state->client->dev,
+					 "%s: config status read failed, retry %d\n",
+					 __func__, i);
 		}
 
-		if (DS5_START_MAX_COUNT == i) {
+		if (!started) {
+			ds5_read(state, stream_status_base, &streaming);
+			ds5_read(state, config_status_base, &status);
 			dev_err(&state->client->dev,
-				"%s start streaming failed, exit on timeout\n", __func__);
+				"%s start streaming timed out after %ums, retries %d, stream status 0x%04x, config status 0x%04x\n",
+				__func__, jiffies_to_msecs(jiffies - start), i,
+				streaming, status);
 			/* notify fw */
 			ret = ds5_write(state, DS5_START_STOP_STREAM,
 					DS5_STREAM_STOP | sensor->stream_cfg.stream_id);
 			ret = -EAGAIN;
 			goto restore_s_state;
 		} else {
-			dev_dbg(&state->client->dev, "%s started after %dms\n",
-				__func__, i * DS5_START_POLL_TIME);
+			dev_dbg(&state->client->dev, "%s started after %ums\n",
+				__func__, jiffies_to_msecs(jiffies - start));
 		}
 	} else {
 		dev_dbg(&state->client->dev, "%s: stopping stream. reg %x val %x\n",
-- 
2.43.0

