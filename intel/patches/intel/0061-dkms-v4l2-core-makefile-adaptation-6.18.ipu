From c24afc764f952fb9242cf61cbf5ee5f2dcc17505 Mon Sep 17 00:00:00 2001
From: florent pirou <florent.pirou@intel.com>
Date: Mon, 17 Nov 2025 07:44:33 -0700
Subject: [PATCH 61/73] dkms : v4l2-core makefile adaptation 6.18

Signed-off-by: florent pirou <florent.pirou@intel.com>
---
 drivers/media/v4l2-core/Makefile   | 3 +++
 drivers/media/v4l2-core/v4l2-dev.c | 1 +
 2 files changed, 4 insertions(+)

diff --git a/drivers/media/v4l2-core/Makefile b/drivers/media/v4l2-core/Makefile
index 2177b9d63a8f..fc41f58d96aa 100644
--- a/drivers/media/v4l2-core/Makefile
+++ b/drivers/media/v4l2-core/Makefile
@@ -2,6 +2,9 @@
 #
 # Makefile for the V4L2 core
 #
+# dkms appendix
+CC := ${CC} -I ${M}/../../../include-overrides -I ${M}/../tuners -I ${M}/../dvb-core -I ${M}/../dvb-frontends
+ccflags-y := -DDRIVER_VERSION_SUFFIX=\"${DRIVER_VERSION_SUFFIX}\"
 
 ccflags-y += -I$(srctree)/drivers/media/dvb-frontends
 ccflags-y += -I$(srctree)/drivers/media/tuners
diff --git a/drivers/media/v4l2-core/v4l2-dev.c b/drivers/media/v4l2-core/v4l2-dev.c
index 10a126e50c1c..96cc91dc9cd1 100644
--- a/drivers/media/v4l2-core/v4l2-dev.c
+++ b/drivers/media/v4l2-core/v4l2-dev.c
@@ -1256,3 +1256,4 @@ MODULE_AUTHOR("Alan Cox, Mauro Carvalho Chehab <mchehab@kernel.org>, Bill Dirks,
 MODULE_DESCRIPTION("Video4Linux2 core driver");
 MODULE_LICENSE("GPL");
 MODULE_ALIAS_CHARDEV_MAJOR(VIDEO_MAJOR);
+MODULE_VERSION(DRIVER_VERSION_SUFFIX);
-- 
2.34.1

