From 8e0236f7e12e5f2ce44570342a0e9717873e8d99 Mon Sep 17 00:00:00 2001
From: Kris Pan <kris.pan@intel.com>
Date: Thu, 5 Nov 2026 14:36:03 +0800
Subject: [PATCH 50/50] media: v4l2-async: drop the downstream src_pad field

The field was added for the lt6911uxc split mode and is no longer used now
that IPU6 resolves the source pad from the CSI-2 endpoint.

It changes the layout of struct v4l2_async_connection, shifts the
offsets of all following members, and changes the genksyms CRCs of
symbols exported by videodev, v4l2-async and v4l2-fwnode.  That breaks
every stock module built against an unmodified kernel.

Drop it to restore the upstream ABI.

Fixes: 5c48120552eef ("media: lt6911: 2 pads linked to ipu 2 ports for split mode")
Signed-off-by: Kris Pan <kris.pan@intel.com>
---
 drivers/media/v4l2-core/v4l2-async.c | 16 +---------------
 include/media/v4l2-async.h           |  2 --
 2 files changed, 1 insertion(+), 17 deletions(-)

diff --git a/drivers/media/v4l2-core/v4l2-async.c b/drivers/media/v4l2-core/v4l2-async.c
index 08ac7a86af45..5f6685e34d90 100644
--- a/drivers/media/v4l2-core/v4l2-async.c
+++ b/drivers/media/v4l2-core/v4l2-async.c
@@ -123,18 +123,6 @@ match_fwnode_one(struct v4l2_async_notifier *notifier,
 		"v4l2-async: device--endpoint match %sfound\n",
 		ret ? "" : "not ");
 
-	if (ret) {
-		struct fwnode_endpoint fwnode_ep = { 0 };
-		int ret_ep;
-		ret_ep = fwnode_graph_parse_endpoint(match->fwnode, &fwnode_ep);
-		if (ret_ep >= 0) {
-			match->src_pad = fwnode_ep.port;
-		} else {
-			match->src_pad = -1;
-		}
-
-	}
-
 	return ret;
 }
 
@@ -212,10 +200,8 @@ v4l2_async_find_match(struct v4l2_async_notifier *notifier,
 		}
 
 		/* match cannot be NULL here */
-		if (match(notifier, sd, &asc->match)) {
-			asc->src_pad = asc->match.src_pad;
+		if (match(notifier, sd, &asc->match))
 			return asc;
-		}
 	}
 
 	return NULL;
diff --git a/include/media/v4l2-async.h b/include/media/v4l2-async.h
index 6f411e9dfc23..54a2d9620ed5 100644
--- a/include/media/v4l2-async.h
+++ b/include/media/v4l2-async.h
@@ -59,7 +59,6 @@ struct v4l2_async_match_desc {
 			unsigned short address;
 		} i2c;
 	};
-	s16 src_pad;
 };
 
 /**
@@ -83,7 +82,6 @@ struct v4l2_async_connection {
 	struct list_head asc_entry;
 	struct list_head asc_subdev_entry;
 	struct v4l2_subdev *sd;
-	s16 src_pad;
 };
 
 /**
-- 
2.34.1

