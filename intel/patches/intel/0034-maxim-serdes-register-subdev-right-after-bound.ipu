From dfd3f0276d5b1e24c4a289c1cdbf3dab32c112aa Mon Sep 17 00:00:00 2001
From: "Khai Wen, Ng" <khai.wen.ng@intel.com>
Date: Mon, 7 Sep 2026 16:57:16 +0800
Subject: [PATCH 34/47] maxim-serdes: register subdev right after bound

Instead of waiting all probe completed and register the subdev
through isys_notifier_complete function.

Signed-off-by: Khai Wen, Ng <khai.wen.ng@intel.com>
---
 drivers/media/i2c/maxim-serdes/max_des.c | 9 ++++++++-
 drivers/media/i2c/maxim-serdes/max_ser.c | 9 ++++++++-
 2 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/drivers/media/i2c/maxim-serdes/max_des.c b/drivers/media/i2c/maxim-serdes/max_des.c
index a9ae24bae940..d6fac00d513e 100644
--- a/drivers/media/i2c/maxim-serdes/max_des.c
+++ b/drivers/media/i2c/maxim-serdes/max_des.c
@@ -14,6 +14,7 @@
 
 #include <media/mipi-csi2.h>
 #include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
 #include <media/v4l2-fwnode.h>
 #include <media/v4l2-subdev.h>
 
@@ -2896,7 +2897,13 @@ static int max_des_notify_bound(struct v4l2_async_notifier *nf,
 		return ret;
 	}
 
-	return 0;
+	ret = v4l2_device_register_subdev_nodes(subdev->v4l2_dev);
+	if (ret) {
+		dev_err(priv->dev, "Failed to register subdev nodes for %s, ret = %d\n",
+			subdev->name, ret);
+		return ret;
+	}
+	return ret;
 }
 
 static void max_des_notify_unbind(struct v4l2_async_notifier *nf,
diff --git a/drivers/media/i2c/maxim-serdes/max_ser.c b/drivers/media/i2c/maxim-serdes/max_ser.c
index 423bad5869a1..03745a8d8961 100644
--- a/drivers/media/i2c/maxim-serdes/max_ser.c
+++ b/drivers/media/i2c/maxim-serdes/max_ser.c
@@ -14,6 +14,7 @@
 
 #include <media/mipi-csi2.h>
 #include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
 #include <media/v4l2-fwnode.h>
 #include <media/v4l2-subdev.h>
 
@@ -1839,7 +1840,13 @@ static int max_ser_notify_bound(struct v4l2_async_notifier *nf,
 		return ret;
 	}
 
-	return 0;
+	ret = v4l2_device_register_subdev_nodes(subdev->v4l2_dev);
+	if (ret) {
+		dev_err(priv->dev, "Failed to register subdev nodes for %s, ret = %d\n",
+			subdev->name, ret);
+		return ret;
+	}
+	return ret;
 }
 
 static void max_ser_notify_unbind(struct v4l2_async_notifier *nf,
-- 
2.34.1

