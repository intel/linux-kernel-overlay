+static unsigned int ipu7_isys_get_running_fw_task_count(
+					      struct ipu7_bus_device *adev)
+{
+	struct ipu7_isys *isys = ipu7_bus_get_drvdata(adev);
+	unsigned long flags;
+	unsigned int count;
+
+	if (!isys)
+		return 0;
+
