-	unsigned int i;
-
-	for (i = 0; i < DPHY_FREQ_RANGE_NUM; i++) {
-		if (mbps > freqranges[i].max)
-			continue;
-
-		if (mbps < freqranges[i].min)
-			break;
-
-		if (best == DPHY_FREQ_RANGE_INVALID_INDEX ||
-		    freqranges[i].osc_freq_target >
