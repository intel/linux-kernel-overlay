@@ -405,15 +339,58 @@ static int __ipu6_mmu_map(struct ipu6_mmu_info *mmu_info, unsigned long iova,
 	return l2_map(mmu_info, iova_start, paddr, size);
 }
 
-static void __ipu6_mmu_unmap(struct ipu6_mmu_info *mmu_info,
