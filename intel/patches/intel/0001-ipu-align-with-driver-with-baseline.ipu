+++ b/drivers/staging/media/ipu7/ipu7-isys-video.c
@@ -100,25 +100,6 @@ const struct ipu7_isys_pixelformat ipu7_isys_pfmts[] = {
 	 IPU_INSYS_FRAME_FORMAT_RAW8},
 };
 
-static int video_open(struct file *file)
-{
