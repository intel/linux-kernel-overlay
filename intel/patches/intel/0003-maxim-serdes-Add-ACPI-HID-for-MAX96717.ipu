From c8e18502799b154c4cb558e787b4136065c1b698 Mon Sep 17 00:00:00 2001
From: "Yew, Chang Ching" <chang.ching.yew@intel.com>
Date: Thu, 17 Sep 2026 16:44:14 +0800
Subject: [PATCH 03/17] maxim-serdes: Add ACPI HID for MAX96717

Assign INTC1141 as ACPI HID of MAX96717 serializer

Signed-off-by: Yew, Chang Ching <chang.ching.yew@intel.com>
---
 drivers/media/i2c/maxim-serdes/max96717.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/media/i2c/maxim-serdes/max96717.c b/drivers/media/i2c/maxim-serdes/max96717.c
index 5fff41f85eae..b9eacceff303 100644
--- a/drivers/media/i2c/maxim-serdes/max96717.c
+++ b/drivers/media/i2c/maxim-serdes/max96717.c
@@ -1987,6 +1987,7 @@ static const struct max96717_chip_info max96717_info = {
 static const struct acpi_device_id max96717_acpi_ids[] = {
 	{ "INTC1138", (kernel_ulong_t)&max9295a_info},
 	{ "INTC1140", (kernel_ulong_t)&max9295d_info},
+	{ "INTC1141", (kernel_ulong_t)&max96717_info},
 	{}
 };
 MODULE_DEVICE_TABLE(acpi, max96717_acpi_ids);
-- 
2.43.0

