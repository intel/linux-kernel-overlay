From d8e236015894182cde0194d38788dc07b31ee437 Mon Sep 17 00:00:00 2001
From: KhaiWenTan <khai.wen.tan@intel.com>
Date: Thu, 20 Aug 2026 19:06:33 +0800
Subject: [PATCH 2/2] net: stmmac: Restrict forcing link speed for Intel mGbE
 2.5G mode

MAC-capabilities initialization has moved to stmmac_mac_get_caps(). Hence,
the removed 10 Mbps, 100 Mbps, and 1Gbps support from mac_capabilities list
in stmmac_phy_setup() will be restored in stmmac_mac_get_caps(). Hence,
moving the mac_capabilities adjustment operation to stmmac_mac_get_caps()
to ensure the list won't be overwritten.

Even removed from mac_capabilities list, userspace still able to force
unavailable link speed with ethtool. Thus, add restriction to ethtool so
that ethtool only support link speed that is available in Intel mGbE 2.5G
mode, which is 2500baseT/Full.

Fixes: 266b25dc0b2f ("net: stmmac: Adjust mac_capabilities for Intel mGbE 2.5G mode")
Signed-off-by: KhaiWenTan <khai.wen.tan@intel.com>
---
 .../ethernet/stmicro/stmmac/stmmac_ethtool.c    |  7 +++++++
 .../net/ethernet/stmicro/stmmac/stmmac_main.c   | 17 ++++++++---------
 2 files changed, 15 insertions(+), 9 deletions(-)

diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c b/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c
index 741e3864f5094..5f591a79d543d 100644
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c
@@ -332,6 +332,13 @@ stmmac_ethtool_set_link_ksettings(struct net_device *dev,
 {
 	struct stmmac_priv *priv = netdev_priv(dev);
 
+	/* Under Intel mGbE 2.5Gbps mode, only 2500baseT/Full is supported, reject
+	 * forced link modes which are absent from the MAC capability mask.
+	 */
+	if (!(priv->phylink_config.mac_capabilities &
+	     (MAC_10 | MAC_100 | MAC_1000)))
+		return -EINVAL;
+
 	return phylink_ethtool_ksettings_set(priv->phylink, cmd);
 }
 
diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
index 35d61e9f29c6f..dd30dc38e272d 100644
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
@@ -827,6 +827,14 @@ static unsigned long stmmac_mac_get_caps(struct phylink_config *config,
 	if (priv->plat->max_speed)
 		phylink_limit_mac_speed(config, priv->plat->max_speed);
 
+	/* In the case where kernel driver has no access to modify the clock
+	 * rate after it is increased by 2.5 times in the BIOS to support 2.5G
+	 * mode, link speeds other than 2.5Gbps are not supported. Thus, remove
+	 * them from mac_capabilities.
+	 */
+	if (priv->plat->fixed_2G5_clock_rate && priv->plat->max_speed == 2500)
+		config->mac_capabilities &= ~(MAC_10 | MAC_100 | MAC_1000);
+
 	return config->mac_capabilities;
 }
 
@@ -1240,15 +1248,6 @@ static int stmmac_phy_setup(struct stmmac_priv *priv)
 	if (!fwnode)
 		fwnode = dev_fwnode(priv->device);
 
-	/* In the case where kernel driver has no access to modify the clock
-	 * rate after it is increased by 2.5 times in the BIOS to support 2.5G
-	 * mode, link speeds other than 2.5Gbps are not supported. Thus, remove
-	 * them from mac_capabilities.
-	 */
-	if (priv->plat->fixed_2G5_clock_rate && priv->plat->max_speed == 2500)
-		priv->phylink_config.mac_capabilities &=
-			~(MAC_10 | MAC_100 | MAC_1000);
-
 	phylink = phylink_create(config, fwnode, priv->plat->phy_interface,
 				 &stmmac_phylink_mac_ops);
 	if (IS_ERR(phylink))
-- 
2.43.0

