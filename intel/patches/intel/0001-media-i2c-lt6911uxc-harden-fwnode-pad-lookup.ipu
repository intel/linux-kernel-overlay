From f826aa426a46c28accdc394ac67708c501f6926d Mon Sep 17 00:00:00 2001
From: Kris Pan <kris.pan@intel.com>
Date: Wed, 11 Nov 2026 14:21:55 +0800
Subject: [PATCH] media: i2c: lt6911uxc: harden fwnode pad lookup

Use the __free(fwnode_handle) scope-based cleanup for the fwnode
reference, so it is held until the function returns and released
automatically.  Guard sd->dev, skip error pointers in
sd->fwnode->secondary, and also treat the endpoint itself as a valid
secondary fwnode.

This follows the upstream direction of using scope-based cleanup for
fwnode references and avoids manual put placement.  There is no behavior
change for the ipu-bridge dummy port, which is matched through the
secondary fwnode's port parent.

Signed-off-by: Kris Pan <kris.pan@intel.com>
---
 drivers/media/i2c/lt6911uxc.c | 21 ++++++++++-----------
 1 file changed, 10 insertions(+), 11 deletions(-)

diff --git a/drivers/media/i2c/lt6911uxc.c b/drivers/media/i2c/lt6911uxc.c
index 155e0da2a6b4b..8273fbe35de86 100644
--- a/drivers/media/i2c/lt6911uxc.c
+++ b/drivers/media/i2c/lt6911uxc.c
@@ -508,25 +508,24 @@ static const struct v4l2_subdev_ops lt6911uxc_subdev_ops = {
 static int lt6911uxc_get_fwnode_pad(struct media_entity *entity,
 				    struct fwnode_endpoint *endpoint)
 {
-	struct fwnode_handle *fwnode;
+	struct fwnode_handle *fwnode __free(fwnode_handle) =
+		fwnode_graph_get_port_parent(endpoint->local_fwnode);
 	struct v4l2_subdev *sd;
+	int ret = -ENXIO;
 
 	if (!is_media_entity_v4l2_subdev(entity))
 		return -EINVAL;
 
 	sd = media_entity_to_v4l2_subdev(entity);
 
-	fwnode = fwnode_graph_get_port_parent(endpoint->local_fwnode);
+	if (sd->dev && device_match_fwnode(sd->dev, fwnode))
+		ret = endpoint->port;
+	else if (sd->fwnode && !IS_ERR_OR_NULL(sd->fwnode->secondary) &&
+		 (sd->fwnode->secondary == fwnode ||
+		  sd->fwnode->secondary == endpoint->local_fwnode))
+		ret = endpoint->port;
 
-	if (device_match_fwnode(sd->dev, fwnode) ||
-	    (sd->fwnode && sd->fwnode->secondary == fwnode)) {
-		fwnode_handle_put(fwnode);
-		return endpoint->port;
-	}
-
-	fwnode_handle_put(fwnode);
-
-	return -ENXIO;
+	return ret;
 }
 
 static const struct media_entity_operations lt6911uxc_subdev_entity_ops = {
-- 
2.43.0

