From 398704a2fcf2b364279dd4ab5e0a08b37946d9e2 Mon Sep 17 00:00:00 2001
From: linya14x <linx.yang@intel.com>
Date: Fri, 17 Apr 2026 15:30:52 +0800
Subject: [PATCH 14/47] ipu-bridge: add CPHY support

get DPHY or CPHY mode when parse ssdb

- Changes from ipu7-drivers for PTL MR2

Signed-off-by: linya14x <linx.yang@intel.com>
---
 include/media/ipu-bridge.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/media/ipu-bridge.h b/include/media/ipu-bridge.h
index 0b8639bd95a5..a6d825b9b621 100644
--- a/include/media/ipu-bridge.h
+++ b/include/media/ipu-bridge.h
@@ -97,7 +97,7 @@ struct ipu_sensor_ssdb {
 	u8 pprunit;
 	u8 flashid;
 	u8 phyconfig;
-	u8 reserved3[7];
+	u8 reserved2[7];
 } __packed;
 
 struct ipu_property_names {
-- 
2.34.1

