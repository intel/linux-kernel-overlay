From f69b44803151e0b1e377460bb1a730ace3e542d9 Mon Sep 17 00:00:00 2001
From: Junjie Cao <junjie.cao@intel.com>
Date: Tue, 22 Sep 2026 09:46:30 +0800
Subject: [PATCH 1/2] pps: clients: initialize Intel TIO event timestamps

The Intel TIO client fills ts_real but leaves ts_raw uninitialized when
CONFIG_NTP_PPS is enabled. A bound kernel PPS consumer passes this value
to hardpps().

Initialize the cross-timestamp and PPS event structures to prevent usage
of uninitialized value to other functions.

Co-developed-by: KhaiWenTan <khai.wen.tan@intel.com>
Signed-off-by: KhaiWenTan <khai.wen.tan@intel.com>
Signed-off-by: Junjie Cao <junjie.cao@intel.com>
---
 drivers/pps/clients/pps_tio_client.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/pps/clients/pps_tio_client.c b/drivers/pps/clients/pps_tio_client.c
index ed3d042c8ce6..38ba1c51cc85 100644
--- a/drivers/pps/clients/pps_tio_client.c
+++ b/drivers/pps/clients/pps_tio_client.c
@@ -53,8 +53,8 @@ static int pps_tio_get_time(ktime_t *device,
 static int pps_tio_convert_cs(struct pps_tio_client *tio_cli, u64 art_cycles,
 			      struct system_time_snapshot snap)
 {
-	struct system_device_crosststamp xts;
-	struct pps_event_time ets;
+	struct system_device_crosststamp xts = { };
+	struct pps_event_time ets = { };
 	int ret;
 
 	ret = get_device_system_crosststamp(pps_tio_get_time,
-- 
2.34.1

