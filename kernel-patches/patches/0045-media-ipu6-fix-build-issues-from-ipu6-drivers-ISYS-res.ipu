From 398df99be9dc2d4a058c2789a49efaf06c51c414 Mon Sep 17 00:00:00 2001
From: syafiqnizam25 <muhammadsyafiqnizamuddinx.binshafie@intel.com>
Date: Mon, 28 Sep 2026 13:04:54 +0800
Subject: [PATCH 45/47] media: ipu6: fix build issues from ipu6-drivers ISYS
 reset update

These fixes are not from ipu6-drivers, ipu7-drivers or
drivers.camera.scaling.sensor. They fix CICD build failures found
after bringing in "media: ipu6: Enable ISYS reset" from ipu6-drivers.

- Guard reset_mutex/need_reset users in isys_runtime_pm_suspend() and
  ipu6_isys_fw_close() with CONFIG_VIDEO_INTEL_IPU6_ISYS_RESET, as the
  fields only exist when the option is enabled
- Remove the unused 'av' variable in return_buffers()

Signed-off-by: syafiqnizam25 <muhammadsyafiqnizamuddinx.binshafie@intel.com>
---
 drivers/media/pci/intel/ipu6/ipu6-isys-queue.c | 1 -
 drivers/media/pci/intel/ipu6/ipu6-isys-video.c | 8 +++++---
 drivers/media/pci/intel/ipu6/ipu6-isys.c       | 2 ++
 3 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/drivers/media/pci/intel/ipu6/ipu6-isys-queue.c b/drivers/media/pci/intel/ipu6/ipu6-isys-queue.c
index 1c0d1766668a..c5c30e7c9345 100644
--- a/drivers/media/pci/intel/ipu6/ipu6-isys-queue.c
+++ b/drivers/media/pci/intel/ipu6/ipu6-isys-queue.c
@@ -513,7 +513,6 @@ static int ipu6_isys_link_fmt_validate(struct ipu6_isys_queue *aq)
 static void return_buffers(struct ipu6_isys_queue *aq,
 			   enum vb2_buffer_state state)
 {
-	struct ipu6_isys_video *av = ipu6_isys_queue_to_video(aq);
 	struct ipu6_isys_buffer *ib;
 	unsigned long flags;
 
diff --git a/drivers/media/pci/intel/ipu6/ipu6-isys-video.c b/drivers/media/pci/intel/ipu6/ipu6-isys-video.c
index 412a81dd77a5..b4204cb73fec 100644
--- a/drivers/media/pci/intel/ipu6/ipu6-isys-video.c
+++ b/drivers/media/pci/intel/ipu6/ipu6-isys-video.c
@@ -1266,14 +1266,16 @@ void ipu6_isys_fw_close(struct ipu6_isys *isys)
 
 	mutex_unlock(&isys->mutex);
 
+#ifdef CONFIG_VIDEO_INTEL_IPU6_ISYS_RESET
 	mutex_lock(&isys->reset_mutex);
 	if (isys->need_reset) {
 		mutex_unlock(&isys->reset_mutex);
 		pm_runtime_put_sync(&isys->adev->auxdev.dev);
-	} else {
-		mutex_unlock(&isys->reset_mutex);
-		pm_runtime_put(&isys->adev->auxdev.dev);
+		return;
 	}
+	mutex_unlock(&isys->reset_mutex);
+#endif
+	pm_runtime_put(&isys->adev->auxdev.dev);
 }
 
 int ipu6_isys_setup_video(struct ipu6_isys_video *av,
diff --git a/drivers/media/pci/intel/ipu6/ipu6-isys.c b/drivers/media/pci/intel/ipu6/ipu6-isys.c
index 89308b00fd98..abc00160c3bc 100644
--- a/drivers/media/pci/intel/ipu6/ipu6-isys.c
+++ b/drivers/media/pci/intel/ipu6/ipu6-isys.c
@@ -1284,9 +1284,11 @@ static int isys_runtime_pm_suspend(struct device *dev)
 	isys->power = 0;
 	spin_unlock_irqrestore(&isys->power_lock, flags);
 
+#ifdef CONFIG_VIDEO_INTEL_IPU6_ISYS_RESET
 	mutex_lock(&isys->reset_mutex);
 	isys->need_reset = false;
 	mutex_unlock(&isys->reset_mutex);
+#endif
 
 	isys->phy_termcal_val = 0;
 	cpu_latency_qos_update_request(&isys->pm_qos, PM_QOS_DEFAULT_VALUE);
-- 
2.34.1

