From 040ac2fb0624bd532e5702f341c11863ee25591c Mon Sep 17 00:00:00 2001
From: "Khai Wen, Ng" <khai.wen.ng@intel.com>
Date: Tue, 9 Jun 2026 10:04:57 +0800
Subject: [PATCH 44/73] max9x: Add bound checking

csi_link_id, serial_link_id, pipe_id should never be equal
to num_csi_links, num_serial_links, num_video_pipes.

Signed-off-by: Khai Wen, Ng <khai.wen.ng@intel.com>
---
 drivers/media/i2c/max9x/max9296.c  |  2 +-
 drivers/media/i2c/max9x/max96724.c |  2 +-
 drivers/media/i2c/max9x/serdes.c   | 24 +++++++++++++++++++-----
 3 files changed, 21 insertions(+), 7 deletions(-)

diff --git a/drivers/media/i2c/max9x/max9296.c b/drivers/media/i2c/max9x/max9296.c
index be144f188de0..b7ba93b5a9e3 100644
--- a/drivers/media/i2c/max9x/max9296.c
+++ b/drivers/media/i2c/max9x/max9296.c
@@ -502,7 +502,7 @@ static int max9296_set_csi_link_enabled(struct max9x_common *common, unsigned in
 	struct max9x_serdes_csi_link *csi_link;
 	int ret = 0;
 
-	if (csi_id > common->num_csi_links)
+	if (csi_id >= common->num_csi_links)
 		return -EINVAL;
 
 	csi_link = &common->csi_link[csi_id];
diff --git a/drivers/media/i2c/max9x/max96724.c b/drivers/media/i2c/max9x/max96724.c
index 5852bc78ccc6..bc4108c42cca 100644
--- a/drivers/media/i2c/max9x/max96724.c
+++ b/drivers/media/i2c/max9x/max96724.c
@@ -615,7 +615,7 @@ static int max96724_set_csi_link_enabled(struct max9x_common *common,
 	struct max9x_serdes_csi_link *csi_link;
 	int ret = 0;
 
-	if (csi_id > common->num_csi_links)
+	if (csi_id >= common->num_csi_links)
 		return -EINVAL;
 
 	csi_link = &common->csi_link[csi_id];
diff --git a/drivers/media/i2c/max9x/serdes.c b/drivers/media/i2c/max9x/serdes.c
index 089e80fac74c..1cf19c818eac 100644
--- a/drivers/media/i2c/max9x/serdes.c
+++ b/drivers/media/i2c/max9x/serdes.c
@@ -1333,6 +1333,13 @@ static void max9x_des_s_csi_link(struct max9x_common *common,
 			unsigned int csi_link_id =
 				video_pipe->config.map[map_id].dst_csi;
 
+			if (csi_link_id >= common->num_csi_links) {
+				dev_warn(common->dev,
+					 "Invalid dst_csi %d for video pipe %d map %d",
+					 csi_link_id, video_pipe_id, map_id);
+				continue;
+			}
+
 			if (common->csi_link[csi_link_id].config.auto_start)
 				continue; /* Already started at probe */
 
@@ -2334,7 +2341,7 @@ static int max9x_parse_serial_link_pdata(struct max9x_common *common,
 	struct device *dev = common->dev;
 	unsigned int serial_link_id = serial_link_pdata->link_id;
 
-	if (serial_link_id > common->num_serial_links) {
+	if (serial_link_id >= common->num_serial_links) {
 		dev_err(dev, "Serial link pdata: Invalid link id");
 		return -EINVAL;
 	}
@@ -2370,11 +2377,11 @@ static int max9x_parse_video_pipe_pdata(struct max9x_common *common,
 	unsigned int max_maps;
 	unsigned int max_data_types;
 
-	if (serial_link_id > common->num_serial_links) {
+	if (serial_link_id >= common->num_serial_links) {
 		dev_err(dev, "Video pdata: Invalid serial link id");
 		return -EINVAL;
 	}
-	if (pipe_id > common->num_video_pipes) {
+	if (pipe_id >= common->num_video_pipes) {
 		dev_err(dev, "Video pdata: Invalid video pipe id");
 		return -EINVAL;
 	}
@@ -2448,7 +2455,7 @@ static int max9x_parse_csi_link_pdata(struct max9x_common *common,
 {
 	unsigned int csi_link_id = csi_link_pdata->link_id;
 
-	if (csi_link_id > common->num_csi_links) {
+	if (csi_link_id >= common->num_csi_links) {
 		dev_err(common->dev, "CSI link pdata: Invalid link id");
 		return -EINVAL;
 	}
@@ -2483,7 +2490,14 @@ static int max9x_parse_subdev_pdata(struct max9x_common *common,
 				    struct max9x_subdev_pdata *subdev_pdata)
 {
 	unsigned int serial_link_id = subdev_pdata->serial_link_id;
-	struct max9x_serdes_serial_link *serial_link = &common->serial_link[serial_link_id];
+	struct max9x_serdes_serial_link *serial_link;
+
+	if (serial_link_id >= common->num_serial_links) {
+		dev_err(common->dev, "Subdev pdata: Invalid serial link id");
+		return -EINVAL;
+	}
+
+	serial_link = &common->serial_link[serial_link_id];
 
 	if (!serial_link->enabled)
 		return 0;
-- 
2.34.1

