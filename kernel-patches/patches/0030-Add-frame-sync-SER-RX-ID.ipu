From f1bbe2bc0babe3485f9290cb3d122a9b08702d33 Mon Sep 17 00:00:00 2001
From: "Seng Guan, Chng" <seng.guan.chng@intel.com>
Date: Fri, 21 Aug 2026 15:58:53 +0800
Subject: [PATCH 30/47] Add frame sync SER RX ID

Add in serializer receive id, which let user to configure
where is the frame sync pulse source come from.
Also rework on serializer codes.

Signed-off-by: Seng Guan, Chng <seng.guan.chng@intel.com>
---
 drivers/media/i2c/isx031.c                |  1 +
 drivers/media/i2c/maxim-serdes/max96717.c | 38 +++++++-----------
 drivers/media/i2c/maxim-serdes/max_ser.c  | 48 +++++++++++++++++++++++
 drivers/media/i2c/maxim-serdes/max_ser.h  |  5 +++
 4 files changed, 68 insertions(+), 24 deletions(-)

diff --git a/drivers/media/i2c/isx031.c b/drivers/media/i2c/isx031.c
index 62ec05e1f01f..8235c4cecdb9 100644
--- a/drivers/media/i2c/isx031.c
+++ b/drivers/media/i2c/isx031.c
@@ -236,6 +236,7 @@ static const struct isx031_reg_list isx031_framesync_reg_list = {
 static const struct isx031_reg_list isx031_1920_1536_reg_list = {
 	.num_of_regs = ARRAY_SIZE(isx031_1920_1536_reg),
 	.regs = isx031_1920_1536_reg,
+};
 
 static const struct isx031_reg_list isx031_framesync_stream_reg_list = {
 	.num_of_regs = ARRAY_SIZE(isx031_framesync_stream_reg),
diff --git a/drivers/media/i2c/maxim-serdes/max96717.c b/drivers/media/i2c/maxim-serdes/max96717.c
index 7fcd87446fee..0ea6585dafb2 100644
--- a/drivers/media/i2c/maxim-serdes/max96717.c
+++ b/drivers/media/i2c/maxim-serdes/max96717.c
@@ -227,7 +227,6 @@ struct max96717_priv {
 	struct pinctrl_desc pctldesc;
 	struct gpio_chip gc;
 	const struct max96717_chip_info *info;
-	unsigned int frame_sync_gpio_pin;
 
 	struct device *dev;
 	struct i2c_client *client;
@@ -1448,18 +1447,22 @@ static int max96717_init_tpg(struct max_ser *ser)
 
 static int max96717_configure_frame_sync(struct max96717_priv *priv)
 {
-	unsigned int pin = priv->frame_sync_gpio_pin;
+	unsigned int pin = priv->ser.frame_sync_gpio_pin;
 	int ret;
 
-	ret = regmap_write(priv->regmap, MAX96717_GPIO_C(pin),
-			   FIELD_PREP(MAX96717_GPIO_C_GPIO_RX_ID, pin));
+	ret = regmap_update_bits(priv->regmap, MAX96717_GPIO_C(pin),
+				 MAX96717_GPIO_C_GPIO_RX_ID,
+				 FIELD_PREP(MAX96717_GPIO_C_GPIO_RX_ID,
+					    priv->ser.frame_sync_rx_id));
 	if (ret) {
 		dev_err(priv->dev, "Failed to configure GPIO_C(%u) for frame sync: %d\n", pin, ret);
 		return ret;
 	}
 
-	ret = regmap_write(priv->regmap, MAX96717_GPIO_A(pin),
-			   MAX96717_GPIO_A_RES_CFG | MAX96717_GPIO_A_GPIO_RX_EN);
+	ret = regmap_update_bits(priv->regmap, MAX96717_GPIO_A(pin),
+				 MAX96717_GPIO_A_RES_CFG | MAX96717_GPIO_A_GPIO_RX_EN |
+				 MAX96717_GPIO_A_GPIO_OUT_DIS,
+				 MAX96717_GPIO_A_RES_CFG | MAX96717_GPIO_A_GPIO_RX_EN);
 	if (ret) {
 		dev_err(priv->dev, "Failed to configure GPIO_A(%u) for frame sync: %d\n", pin, ret);
 		return ret;
@@ -1472,7 +1475,6 @@ static int max96717_configure_frame_sync(struct max96717_priv *priv)
 static int max96717_init(struct max_ser *ser)
 {
 	struct max96717_priv *priv = ser_to_priv(ser);
-	u32 frame_sync_enable = 0;
 	int ret;
 
 	/*
@@ -1506,26 +1508,14 @@ static int max96717_init(struct max_ser *ser)
 		return ret;
 
 	/*
-	 * External GMSL frame sync is opt-in via the ACPI _DSD property
-	 * "gmsl-frame-sync-enable" (defaults to disabled when absent or 0).
+	 * External GMSL frame sync is opt-in; ser->frame_sync_* is parsed
+	 * from the ACPI "fsync" child node by max_ser_parse_dt().
 	 */
-	fwnode_property_read_u32(dev_fwnode(priv->dev), "gmsl-frame-sync-enable",
-				 &frame_sync_enable);
-	if (frame_sync_enable) {
-		/* MFP number is board-specific; ASL's DESCH_SER_EXTRA_GPIO_PIN. */
-		ret = fwnode_property_read_u32(dev_fwnode(priv->dev),
-					       "gmsl-frame-sync-gpio-pin",
-					       &priv->frame_sync_gpio_pin);
-		if (ret) {
-			dev_err(priv->dev,
-				"External GMSL frame_sync requested but no gpio pin defined\n");
-			return ret;
-		}
-
-		if (priv->frame_sync_gpio_pin >= MAX96717_GPIO_NUM) {
+	if (ser->frame_sync_enable) {
+		if (ser->frame_sync_gpio_pin >= MAX96717_GPIO_NUM) {
 			dev_err(priv->dev,
 				"Invalid gmsl-frame-sync-gpio-pin %u\n",
-				priv->frame_sync_gpio_pin);
+				ser->frame_sync_gpio_pin);
 			return -EINVAL;
 		}
 		dev_info(priv->dev, "Enabling external GMSL frame_sync\n");
diff --git a/drivers/media/i2c/maxim-serdes/max_ser.c b/drivers/media/i2c/maxim-serdes/max_ser.c
index 184442bd3087..9355a9510685 100644
--- a/drivers/media/i2c/maxim-serdes/max_ser.c
+++ b/drivers/media/i2c/maxim-serdes/max_ser.c
@@ -2126,6 +2126,50 @@ static int max_ser_find_phys_config(struct max_ser_priv *priv)
 	return 0;
 }
 
+static int max_ser_parse_frame_sync(struct max_ser_priv *priv, struct fwnode_handle *fwnode)
+{
+	struct max_ser *ser = priv->ser;
+	struct fwnode_handle *fsync;
+	u32 val;
+	int ret;
+
+	/*
+	 * External GMSL frame sync is opt-in via the ACPI _DSD property
+	 * "gmsl-frame-sync-enable" (defaults to disabled when absent or 0).
+	 */
+	if (!fwnode_property_read_u32(fwnode, "gmsl-frame-sync-enable", &val))
+		ser->frame_sync_enable = !!val;
+
+	if (!ser->frame_sync_enable)
+		return 0;
+
+	/* gmsl-frame-sync-gpio-pin / maxim,rx-id live under the ASL "fsync" child node. */
+	fsync = fwnode_get_named_child_node(fwnode, "fsync");
+	if (!fsync) {
+		dev_err(priv->dev,
+			"External GMSL frame_sync requested but no fsync node found\n");
+		return -EINVAL;
+	}
+
+	ret = fwnode_property_read_u32(fsync, "gmsl-frame-sync-gpio-pin",
+				       &ser->frame_sync_gpio_pin);
+	if (ret) {
+		dev_err(priv->dev,
+			"External GMSL frame_sync requested but no gpio pin defined\n");
+		fwnode_handle_put(fsync);
+		return ret;
+	}
+
+	ret = fwnode_property_read_u32(fsync, "maxim,rx-id", &ser->frame_sync_rx_id);
+	if (ret)
+		dev_err(priv->dev,
+			"External GMSL frame_sync requested but no rx-id defined\n");
+
+	fwnode_handle_put(fsync);
+
+	return ret;
+}
+
 static int max_ser_parse_dt(struct max_ser_priv *priv)
 {
 	struct fwnode_handle *fwnode = dev_fwnode(priv->dev);
@@ -2135,6 +2179,10 @@ static int max_ser_parse_dt(struct max_ser_priv *priv)
 	unsigned int i;
 	int ret;
 
+	ret = max_ser_parse_frame_sync(priv, fwnode);
+	if (ret)
+		return ret;
+
 	for (i = 0; i < ser->ops->num_phys; i++) {
 		phy = &ser->phys[i];
 		phy->index = i;
diff --git a/drivers/media/i2c/maxim-serdes/max_ser.h b/drivers/media/i2c/maxim-serdes/max_ser.h
index b57776ec5d59..1ebada3ab604 100644
--- a/drivers/media/i2c/maxim-serdes/max_ser.h
+++ b/drivers/media/i2c/maxim-serdes/max_ser.h
@@ -137,6 +137,11 @@ struct max_ser {
 	unsigned int phys_config;
 	unsigned int active;
 	enum max_serdes_gmsl_mode mode;
+
+	/* Parsed from the ACPI "fsync" child node by max_ser_parse_dt(). */
+	bool frame_sync_enable;
+	unsigned int frame_sync_gpio_pin;
+	unsigned int frame_sync_rx_id;
 };
 
 int max_ser_probe(struct i2c_client *client, struct max_ser *ser);
-- 
2.34.1

