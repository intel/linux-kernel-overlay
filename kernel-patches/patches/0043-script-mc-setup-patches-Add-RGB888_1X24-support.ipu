From 435f9f33d9e817d59df4fc8350a24a96ec342eae Mon Sep 17 00:00:00 2001
From: "Khai Wen, Ng" <khai.wen.ng@intel.com>
Date: Sun, 9 Aug 2026 01:18:54 +0800
Subject: [PATCH 43/47] script: mc-setup: patches: Add RGB888_1X24 support

d4xx IR stream has RGB888_1X24 format. Add the format into
script and ipu7-drivers.

- Changes from drivers.camera.scaling.sensor patches/6.18/0006

Signed-off-by: Khai Wen, Ng <khai.wen.ng@intel.com>
---
 drivers/staging/media/ipu7/ipu7-isys-video.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/staging/media/ipu7/ipu7-isys-video.c b/drivers/staging/media/ipu7/ipu7-isys-video.c
index 06aa2682065d..577c40694bd9 100644
--- a/drivers/staging/media/ipu7/ipu7-isys-video.c
+++ b/drivers/staging/media/ipu7/ipu7-isys-video.c
@@ -88,7 +88,7 @@ const struct ipu7_isys_pixelformat ipu7_isys_pfmts[] = {
 	{V4L2_PIX_FMT_RGB565, 16, 16, MEDIA_BUS_FMT_RGB565_1X16,
 	 IPU_INSYS_FRAME_FORMAT_RGB565},
 	{V4L2_PIX_FMT_BGR24, 24, 24, MEDIA_BUS_FMT_RGB888_1X24,
-	 IPU_INSYS_FRAME_FORMAT_RGBA888},
+	 IPU_INSYS_FRAME_FORMAT_RGB888},
 	/* D4XX specific */
 	{V4L2_PIX_FMT_Z16, 16, 16, MEDIA_BUS_FMT_UYVY8_1X16,
 	 IPU_INSYS_FRAME_FORMAT_UYVY},
-- 
2.34.1

