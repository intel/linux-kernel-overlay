From 7a90b4eb8ea1cfe4341a248b980c5e61a2bfc081 Mon Sep 17 00:00:00 2001
From: "Khai Wen, Ng" <khai.wen.ng@intel.com>
Date: Fri, 5 Jun 2026 14:16:34 +0800
Subject: [PATCH 39/73] d4xx: Fix define spacing

Add TODO block to revisit in future.

Signed-off-by: Khai Wen, Ng <khai.wen.ng@intel.com>
---
 drivers/media/i2c/d4xx.c | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/drivers/media/i2c/d4xx.c b/drivers/media/i2c/d4xx.c
index 6c6247c888d0..97cc87f4f396 100644
--- a/drivers/media/i2c/d4xx.c
+++ b/drivers/media/i2c/d4xx.c
@@ -24,11 +24,11 @@
 #endif
 
 /* DS5 device usage */
-#define DS5_DRIVER_NAME 		"d4xx"
-#define DS5_DRIVER_NAME_AWG 	"d4xx-awg"
-#define DS5_DRIVER_NAME_ASR 	"d4xx-asr"
-#define DS5_DRIVER_NAME_CLASS 	"d4xx-class"
-#define DS5_DRIVER_NAME_DFU 	"d4xx-dfu"
+#define DS5_DRIVER_NAME "d4xx"
+#define DS5_DRIVER_NAME_AWG "d4xx-awg"
+#define DS5_DRIVER_NAME_ASR "d4xx-asr"
+#define DS5_DRIVER_NAME_CLASS "d4xx-class"
+#define DS5_DRIVER_NAME_DFU "d4xx-dfu"
 #define DS5_FW_VERSION			0x030C
 #define DS5_FW_BUILD			0x030E
 #define DS5_DEVICE_TYPE			0x0310
@@ -1709,6 +1709,8 @@ static int _mux_set_routing(struct v4l2_subdev *sd,
 	ds5->routing_initialized = 1;
 	return 0;
 
+	// TODO: Check if we can remove below blocks
+
 	/* get format from sink pads*/
     for (unsigned int i = 0; i < routing->num_routes; i++) {
 	const struct v4l2_subdev_route *route = &routing->routes[i];
-- 
2.34.1

