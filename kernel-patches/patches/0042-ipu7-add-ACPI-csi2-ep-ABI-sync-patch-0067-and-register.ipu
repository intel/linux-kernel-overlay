From 10ca0eff2a29125b09c15f5fd830be7662a03101 Mon Sep 17 00:00:00 2001
From: "Sodhi, Vunny" <vunny.sodhi@intel.com>
Date: Mon, 29 Jun 2026 13:04:25 +0800
Subject: [PATCH 42/47] ipu7: add ACPI csi2 ep ABI-sync patch (0067) and
 register in dkms

Fixes a non-canonical fwnode GPF in fwnode_graph_get_remote_endpoint()
during isys_complete_ext_device_registration on the ACPI path, caused by
the csi2 ep field missing from ipu7-drivers/include/media/ipu-acpi.h.

Adds the fix patch and wires it into dkms.conf for 6.17/6.18/7.0.

- Changes from drivers.camera.scaling.sensor patches/6.18/0067

Signed-off-by: Sodhi, Vunny <vunny.sodhi@intel.com>
Signed-off-by: syafiqnizam25 <muhammadsyafiqnizamuddinx.binshafie@intel.com>
---
 include/media/ipu-acpi.h | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/include/media/ipu-acpi.h b/include/media/ipu-acpi.h
index f31833f3e72a..392fc3dacd4b 100644
--- a/include/media/ipu-acpi.h
+++ b/include/media/ipu-acpi.h
@@ -24,10 +24,13 @@
 
 #include <media/v4l2-mediabus.h>
 
+struct fwnode_handle;
+
 struct ipu_isys_csi2_config {
 	unsigned int nlanes;
 	unsigned int port;
 	enum v4l2_mbus_type bus_type;
+	struct fwnode_handle *ep;
 };
 
 struct ipu_isys_subdev_i2c_info {
-- 
2.34.1

