From 733f98028aacbe64c36b2747c0675f08bcc346d2 Mon Sep 17 00:00:00 2001
From: linya14x <linx.yang@intel.com>
Date: Mon, 13 Apr 2026 17:44:24 +0800
Subject: [PATCH 06/47] media: ipu6: Enable ISYS reset

- Changes from ipu6-drivers for ARL MR5

Signed-off-by: linya14x <linx.yang@intel.com>
---
 .../media/pci/intel/ipu6/ipu6-isys-queue.c    | 19 ++++-----
 .../media/pci/intel/ipu6/ipu6-isys-video.c    | 24 +++++------
 drivers/media/pci/intel/ipu6/ipu6-isys.c      | 42 ++++++++++++++++++-
 drivers/media/pci/intel/ipu6/ipu6-isys.h      |  2 +-
 4 files changed, 61 insertions(+), 26 deletions(-)

diff --git a/drivers/media/pci/intel/ipu6/ipu6-isys-queue.c b/drivers/media/pci/intel/ipu6/ipu6-isys-queue.c
index 67cf2530676c..1c0d1766668a 100644
--- a/drivers/media/pci/intel/ipu6/ipu6-isys-queue.c
+++ b/drivers/media/pci/intel/ipu6/ipu6-isys-queue.c
@@ -515,7 +515,6 @@ static void return_buffers(struct ipu6_isys_queue *aq,
 {
 	struct ipu6_isys_video *av = ipu6_isys_queue_to_video(aq);
 	struct ipu6_isys_buffer *ib;
-	bool need_reset = false;
 	unsigned long flags;
 
 	spin_lock_irqsave(&aq->lock, flags);
@@ -538,7 +537,6 @@ static void return_buffers(struct ipu6_isys_queue *aq,
 		vb2_buffer_done(vb, state);
 
 		spin_lock_irqsave(&aq->lock, flags);
-		need_reset = true;
 	}
 
 	while (!list_empty(&aq->incoming)) {
@@ -556,12 +554,6 @@ static void return_buffers(struct ipu6_isys_queue *aq,
 	}
 
 	spin_unlock_irqrestore(&aq->lock, flags);
-
-	if (need_reset) {
-		mutex_lock(&av->isys->mutex);
-		av->isys->need_reset = true;
-		mutex_unlock(&av->isys->mutex);
-	}
 }
 
 static void ipu6_isys_stream_cleanup(struct ipu6_isys_video *av)
@@ -832,6 +824,7 @@ static void stop_streaming(struct vb2_queue *q)
 	struct ipu6_isys_stream *stream = av->stream;
 
 #ifdef CONFIG_VIDEO_INTEL_IPU6_ISYS_RESET
+	bool need_reset;
 	struct device *dev = &av->isys->adev->auxdev.dev;
 
 	dev_dbg(dev, "stop: %s: enter\n", av->vdev.name);
@@ -890,13 +883,17 @@ static void stop_streaming(struct vb2_queue *q)
 	av->start_streaming = 0;
 	mutex_lock(&av->isys->reset_mutex);
 	av->isys->in_stop_streaming = false;
+	need_reset = av->isys->need_reset;
 	mutex_unlock(&av->isys->reset_mutex);
 
-	if (av->isys->need_reset) {
+	if (need_reset) {
 		if (!stream->nr_streaming && !is_support_vc(av))
 			ipu_isys_reset(av, stream);
-		else
-			av->isys->need_reset = 0;
+		else {
+			mutex_lock(&av->isys->reset_mutex);
+			av->isys->need_reset = false;
+			mutex_unlock(&av->isys->reset_mutex);
+		}
 	}
 
 	dev_dbg(dev, "stop: %s: exit\n", av->vdev.name);
diff --git a/drivers/media/pci/intel/ipu6/ipu6-isys-video.c b/drivers/media/pci/intel/ipu6/ipu6-isys-video.c
index a34d1648a58e..0415d6fee607 100644
--- a/drivers/media/pci/intel/ipu6/ipu6-isys-video.c
+++ b/drivers/media/pci/intel/ipu6/ipu6-isys-video.c
@@ -101,17 +101,19 @@ const struct ipu6_isys_pixelformat ipu6_isys_pfmts[] = {
 
 static int video_open(struct file *file)
 {
+#ifdef CONFIG_VIDEO_INTEL_IPU6_ISYS_RESET
 	struct ipu6_isys_video *av = video_drvdata(file);
 	struct ipu6_isys *isys = av->isys;
 	struct ipu6_bus_device *adev = isys->adev;
 
-	mutex_lock(&isys->mutex);
+	mutex_lock(&isys->reset_mutex);
 	if (isys->need_reset) {
-		mutex_unlock(&isys->mutex);
+		mutex_unlock(&isys->reset_mutex);
 		dev_warn(&adev->auxdev.dev, "isys power cycle required\n");
 		return -EIO;
 	}
-	mutex_unlock(&isys->mutex);
+	mutex_unlock(&isys->reset_mutex);
+#endif
 
 	return v4l2_fh_open(file);
 }
@@ -1250,21 +1252,19 @@ void ipu6_isys_fw_close(struct ipu6_isys *isys)
 	mutex_lock(&isys->mutex);
 
 	isys->ref_count--;
-	if (!isys->ref_count) {
+	if (!isys->ref_count)
 		ipu6_fw_isys_close(isys);
-		if (isys->fwcom) {
-			isys->need_reset = true;
-			dev_warn(&isys->adev->auxdev.dev,
-				 "failed to close fw isys\n");
-		}
-	}
 
 	mutex_unlock(&isys->mutex);
 
-	if (isys->need_reset)
+	mutex_lock(&isys->reset_mutex);
+	if (isys->need_reset) {
+		mutex_unlock(&isys->reset_mutex);
 		pm_runtime_put_sync(&isys->adev->auxdev.dev);
-	else
+	} else {
+		mutex_unlock(&isys->reset_mutex);
 		pm_runtime_put(&isys->adev->auxdev.dev);
+	}
 }
 
 int ipu6_isys_setup_video(struct ipu6_isys_video *av,
diff --git a/drivers/media/pci/intel/ipu6/ipu6-isys.c b/drivers/media/pci/intel/ipu6/ipu6-isys.c
index 0a8aa63b74bc..e0afadc947e1 100644
--- a/drivers/media/pci/intel/ipu6/ipu6-isys.c
+++ b/drivers/media/pci/intel/ipu6/ipu6-isys.c
@@ -1114,6 +1114,41 @@ static void isys_notifier_cleanup(struct ipu6_isys *isys)
 	v4l2_async_nf_cleanup(&isys->notifier);
 }
 
+#ifdef CONFIG_VIDEO_INTEL_IPU6_ISYS_RESET
+static void isys_v4l2_notify(struct v4l2_subdev *sd, unsigned int notification,
+			     void *arg)
+{
+	struct ipu6_isys *isys =
+		container_of(sd->v4l2_dev, struct ipu6_isys, v4l2_dev);
+	struct device *dev = &isys->adev->auxdev.dev;
+	struct v4l2_event *ev = arg;
+	unsigned long flags;
+
+	spin_lock_irqsave(&isys->power_lock, flags);
+	if (!isys->power) {
+		spin_unlock_irqrestore(&isys->power_lock, flags);
+		dev_dbg(dev, "%s: isys powered off, ignore notify %u\n",
+			sd->name, notification);
+		return;
+	}
+	spin_unlock_irqrestore(&isys->power_lock, flags);
+
+	if (notification == V4L2_DEVICE_NOTIFY_EVENT) {
+		if ((ev->type == V4L2_EVENT_SOURCE_CHANGE ||
+		     ev->type == V4L2_EVENT_EOS) &&
+		    isys->stream_opened > 1) {
+			dev_dbg(dev, "%s: isys need reset due to notify %u, stream opened %d\n",
+				sd->name, ev->type, isys->stream_opened);
+			mutex_lock(&isys->reset_mutex);
+			isys->need_reset = true;
+			mutex_unlock(&isys->reset_mutex);
+		}
+	} else {
+		dev_warn(dev, "%s: unknown notification %u\n",
+			 sd->name, notification);
+	}
+}
+#endif
 static int isys_register_devices(struct ipu6_isys *isys)
 {
 	struct device *dev = &isys->adev->auxdev.dev;
@@ -1127,6 +1162,9 @@ static int isys_register_devices(struct ipu6_isys *isys)
 	strscpy(isys->v4l2_dev.name, isys->media_dev.model,
 		sizeof(isys->v4l2_dev.name));
 
+#ifdef CONFIG_VIDEO_INTEL_IPU6_ISYS_RESET
+	isys->v4l2_dev.notify = isys_v4l2_notify;
+#endif
 	ret = media_device_register(&isys->media_dev);
 	if (ret < 0)
 		goto out_media_device_unregister;
@@ -1246,9 +1284,9 @@ static int isys_runtime_pm_suspend(struct device *dev)
 	isys->power = 0;
 	spin_unlock_irqrestore(&isys->power_lock, flags);
 
-	mutex_lock(&isys->mutex);
+	mutex_lock(&isys->reset_mutex);
 	isys->need_reset = false;
-	mutex_unlock(&isys->mutex);
+	mutex_unlock(&isys->reset_mutex);
 
 	isys->phy_termcal_val = 0;
 	cpu_latency_qos_update_request(&isys->pm_qos, PM_QOS_DEFAULT_VALUE);
diff --git a/drivers/media/pci/intel/ipu6/ipu6-isys.h b/drivers/media/pci/intel/ipu6/ipu6-isys.h
index e8fae1445f39..1054a4566a3a 100644
--- a/drivers/media/pci/intel/ipu6/ipu6-isys.h
+++ b/drivers/media/pci/intel/ipu6/ipu6-isys.h
@@ -151,7 +151,6 @@ struct ipu6_isys {
 	void *fwcom;
 	unsigned int line_align;
 	u32 phy_termcal_val;
-	bool need_reset;
 	bool icache_prefetch;
 	bool csi2_cse_ipc_not_supported;
 	unsigned int ref_count;
@@ -180,6 +179,7 @@ struct ipu6_isys {
 	struct mutex reset_mutex;
 	bool in_reset;
 	bool in_stop_streaming;
+	bool need_reset;
 #endif
 };
 
-- 
2.34.1

