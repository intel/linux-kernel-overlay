version=3
# uversionmangle rule order matters: '-rc' must become '~rc' BEFORE the
# revision-stripping rule runs. Otherwise that rule's trailing '-.*' eats the
# rc marker itself (tag 'v7.3-rc3' -> '7.3'), and deb-setup's
# --download-version=7.3~rc3 finds no matching upstream version.
opts="mode=git, gitmode=shallow, pgpmode=gittag, uversionmangle=s|-rc|~rc|;s|^([0-9]+\.[0-9]+(\.[0-9]+)?(~rc[0-9]+)?)-.*|\1|;s|\.0$||" \
https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git refs/tags/v(.*) debian
