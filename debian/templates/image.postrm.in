#!/bin/sh -e

version=@abiname@@localversion@
image_path=/boot/@image-stem@-$version

rm -f /lib/modules/$version/.fresh-install

if [ "$1" != upgrade ] && command -v linux-update-symlinks >/dev/null; then
    linux-update-symlinks remove $version $image_path
fi

if command -v linux-run-hooks >/dev/null 2>&1; then
    linux-run-hooks image postrm $version $image_path -- "$@"
fi
# Note: linux-run-hooks may not be available on all systems
# If not found, postrm hooks are skipped (this is normal)

if [ "$1" = purge ]; then
    # Restore GRUB config for RT kernel if this is the last RT kernel
    if echo "$version" | grep -q -- "-rt-"; then
        # Check if there are any other RT kernels installed
        RT_KERNEL_COUNT=$(dpkg -l | grep -c "linux-intel-image-.*-rt-" || true)

        # If this is the last RT kernel (count will be 1 since we haven't removed it yet)
        if [ "$RT_KERNEL_COUNT" -le 1 ]; then
            echo "Removing RT kernel parameters from GRUB configuration..."

            # Remove RT kernel GRUB menu script FIRST
            # This prevents it from running during update-grub
            if [ -f /etc/grub.d/12_linux_rt_optimized ]; then
                rm -f /etc/grub.d/12_linux_rt_optimized
                echo "Removed /etc/grub.d/12_linux_rt_optimized"
            fi

            # Remove RT kernel parameters configuration file
            if [ -f /etc/default/grub.d/rt-kernel-params.cfg ]; then
                rm -f /etc/default/grub.d/rt-kernel-params.cfg
                echo "Removed /etc/default/grub.d/rt-kernel-params.cfg"
            fi

            # Update GRUB to regenerate config without RT entries
            if command -v update-grub >/dev/null 2>&1; then
                update-grub
                echo "RT kernel configuration removed from GRUB."
            elif command -v grub2-mkconfig >/dev/null 2>&1; then
                grub2-mkconfig -o /boot/grub2/grub.cfg
                echo "RT kernel configuration removed from GRUB."
            fi

            if [ -f /etc/default/grub.pre-rt ]; then
                echo "Original GRUB backup preserved at /etc/default/grub.pre-rt"
            fi
        fi
    fi

    for extra_file in modules.dep modules.isapnpmap modules.pcimap \
                      modules.usbmap modules.parportmap \
                      modules.generic_string modules.ieee1394map \
                      modules.ieee1394map modules.pnpbiosmap \
                      modules.alias modules.ccwmap modules.inputmap \
                      modules.symbols modules.ofmap \
                      modules.seriomap modules.\*.bin \
                      modules.softdep modules.weakdep modules.devname; do
	eval rm -f /lib/modules/$version/$extra_file
    done
    rmdir /lib/modules/$version || true
fi

exit 0
