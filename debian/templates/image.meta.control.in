Package: linux@source_suffix@-image@localversion@
Meta-Rules-Target: meta
Meta-Rules-Makeflags: INSTALLDOCS_LINK_DOC=linux@source_suffix@-base@localversion@
Build-Profiles: <!pkg.linux.nokernel !pkg.linux.nometa>
Depends:
 linux@source_suffix@-base@localversion@ (= ${binary:Version}),
 linux@source_suffix@-image-@abiname@@localversion@ (= ${binary:Version}),
 ${misc:Depends},
Provides: linux-latest-modules-@abiname@@localversion@, wireguard-modules (= 1.0.0), virtualbox-guest-modules [amd64]
Description: Linux for @class@ (meta-package)
 This package depends on the latest Linux kernel and modules for use on
 @longclass@.
