#!/bin/sh -e

version=@abiname@@localversion@
image_path=/boot/@image-stem@-$version

if [ "$1" != configure ]; then
    exit 0
fi

depmod $version

if [ -f /lib/modules/$version/.fresh-install ]; then
    change=install
else
    change=upgrade
fi

# Only run if linux-update-symlinks is available
if command -v linux-update-symlinks >/dev/null 2>&1; then
    linux-update-symlinks $change $version $image_path
fi
rm -f /lib/modules/$version/.fresh-install

# Generate initramfs
if command -v dracut >/dev/null 2>&1; then
    echo "Generating initramfs using dracut..."
    dracut --force --hostonly --hostonly-cmdline /boot/initramfs-$version.img $version || \
    dracut --force /boot/initramfs-$version.img $version
elif command -v update-initramfs >/dev/null 2>&1; then
    echo "Generating initramfs using update-initramfs..."
    update-initramfs -c -k $version
else
    echo "WARNING: Neither dracut nor update-initramfs found. Initramfs not generated!"
    echo "The system may not boot without an initramfs."
fi

# Configure RT kernel parameters (only for RT kernels)
if echo "$version" | grep -q -- "-rt-"; then
    echo "Configuring kernel parameters for RT kernel..."

    # RT kernel parameter file (installed by binary package)
    RT_PARAM_FILE="/usr/share/doc/linux-intel-binary-$version/kernel-rt-parameter"

    # GRUB configuration directory for RT parameters
    GRUB_RT_CONFIG_DIR="/etc/default/grub.d"
    GRUB_RT_CONFIG_FILE="$GRUB_RT_CONFIG_DIR/rt-kernel-params.cfg"

    # GRUB script for RT kernel entries
    GRUB_RT_SCRIPT_SRC="/usr/share/linux-intel-binary-$version/12_linux_rt_optimized"
    GRUB_RT_SCRIPT_DST="/etc/grub.d/12_linux_rt_optimized"

    # Install GRUB script for RT kernel menu entries
    if [ -f "$GRUB_RT_SCRIPT_SRC" ]; then
        mkdir -p /etc/grub.d
        cp "$GRUB_RT_SCRIPT_SRC" "$GRUB_RT_SCRIPT_DST"
        chmod +x "$GRUB_RT_SCRIPT_DST"
        echo "Installed RT kernel GRUB menu script: $GRUB_RT_SCRIPT_DST"
    else
        echo "WARNING: RT GRUB script not found at $GRUB_RT_SCRIPT_SRC" >&2
    fi

    if [ -f "$RT_PARAM_FILE" ]; then
        # Read RT parameters from file (single line)
        RT_PARAMS=$(cat "$RT_PARAM_FILE" | tr -d '\n')

        if [ -n "$RT_PARAMS" ]; then
            echo "Setting up RT kernel parameters from $RT_PARAM_FILE"

            # Create grub.d directory if it doesn't exist
            mkdir -p "$GRUB_RT_CONFIG_DIR"

            # Write RT parameters to GRUB config file
            # This file is sourced by /etc/grub.d/12_linux_rt_optimized
            cat > "$GRUB_RT_CONFIG_FILE" <<EOF
# RT Kernel Parameters Configuration
# Generated by linux-intel-image-$version package
# These parameters are ONLY applied to RT kernel menu entries
# Edit this file to customize RT kernel boot parameters

RT_KERNEL_PARAMS="$RT_PARAMS"
EOF

            echo "RT kernel parameters configured in: $GRUB_RT_CONFIG_FILE"
            echo "Parameters: $RT_PARAMS"
            echo ""
            echo "Note: RT parameters will ONLY apply to RT kernel boot entries."
            echo "      Regular kernels will use standard parameters."
        else
            echo "WARNING: RT parameter file is empty."
        fi
    else
        echo "========================================" >&2
        echo "WARNING: RT parameter file not found!" >&2
        echo "Expected at: $RT_PARAM_FILE" >&2
        echo "" >&2
        echo "RT kernel installed WITHOUT custom parameters." >&2
        echo "Boot parameters will NOT be optimized for RT workloads." >&2
        echo "" >&2
        echo "You can manually configure RT parameters by editing:" >&2
        echo "  $GRUB_RT_CONFIG_FILE" >&2
        echo "========================================" >&2
    fi
fi

# Update GRUB to add new kernel to boot menu
if command -v update-grub >/dev/null 2>&1; then
    echo "Updating GRUB boot menu..."
    update-grub
elif command -v grub2-mkconfig >/dev/null 2>&1; then
    echo "Updating GRUB2 boot menu..."
    grub2-mkconfig -o /boot/grub2/grub.cfg
else
    echo "WARNING: GRUB update command not found. Please run 'sudo update-grub' manually."
fi

# Only run hooks if linux-run-hooks is available
if command -v linux-run-hooks >/dev/null 2>&1; then
    linux-run-hooks image postinst $version $image_path -- "$@"
fi

exit 0
