#!/bin/sh -e

version=@abiname@@localversion@
image_path=/boot/@image-stem@-$version

if [ "$1" != configure ]; then
    exit 0
fi

depmod $version

if [ -f /lib/modules/$version/.fresh-install ]; then
    change=install
else
    change=upgrade
fi

# Only run if linux-update-symlinks is available
if command -v linux-update-symlinks >/dev/null 2>&1; then
    linux-update-symlinks $change $version $image_path
fi
rm -f /lib/modules/$version/.fresh-install

# Generate initramfs
if command -v dracut >/dev/null 2>&1; then
    echo "Generating initramfs using dracut..."
    dracut --force --hostonly --hostonly-cmdline /boot/initramfs-$version.img $version || \
    dracut --force /boot/initramfs-$version.img $version
elif command -v update-initramfs >/dev/null 2>&1; then
    echo "Generating initramfs using update-initramfs..."
    update-initramfs -c -k $version
else
    echo "WARNING: Neither dracut nor update-initramfs found. Initramfs not generated!"
    echo "The system may not boot without an initramfs."
fi

# Update kernel parameters for RT kernel
if echo "$version" | grep -q -- "-rt-"; then
    echo "Configuring kernel parameters for RT kernel..."

    # RT kernel parameter file
    RT_PARAM_FILE="/usr/share/doc/linux-intel-image-$version/kernel-rt-parameter"

    # Backup GRUB config if not already backed up
    if [ -f /etc/default/grub ] && [ ! -f /etc/default/grub.pre-rt ]; then
        cp /etc/default/grub /etc/default/grub.pre-rt
        echo "Created backup: /etc/default/grub.pre-rt"
    fi

    if [ -f /etc/default/grub ]; then
        if [ -f "$RT_PARAM_FILE" ]; then
            # Read RT parameters from file (single line)
            RT_PARAMS=$(cat "$RT_PARAM_FILE" | tr -d '\n')

            if [ -n "$RT_PARAMS" ]; then
                echo "Applying RT kernel parameters from $RT_PARAM_FILE"

                # Get current GRUB_CMDLINE_LINUX_DEFAULT value
                CURRENT_CMDLINE=$(grep "^GRUB_CMDLINE_LINUX_DEFAULT=" /etc/default/grub | sed 's/GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"/\1/')

                # Check if RT parameters are already present
                PARAMS_PRESENT=true
                for param in $RT_PARAMS; do
                    param_key=$(echo "$param" | cut -d= -f1)
                    if ! echo "$CURRENT_CMDLINE" | grep -q "$param_key"; then
                        PARAMS_PRESENT=false
                        break
                    fi
                done

                if [ "$PARAMS_PRESENT" = "false" ]; then
                    # Append RT parameters
                    sed -i "s|GRUB_CMDLINE_LINUX_DEFAULT=\"\(.*\)\"|GRUB_CMDLINE_LINUX_DEFAULT=\"\1 $RT_PARAMS\"|" /etc/default/grub

                    # Update GRUB configuration
                    if command -v update-grub >/dev/null 2>&1; then
                        echo "Updating GRUB configuration..."
                        update-grub
                        echo "RT kernel parameters applied. A reboot is required for changes to take effect."
                    elif command -v grub2-mkconfig >/dev/null 2>&1; then
                        echo "Updating GRUB2 configuration..."
                        grub2-mkconfig -o /boot/grub2/grub.cfg
                        echo "RT kernel parameters applied. A reboot is required for changes to take effect."
                    else
                        echo "WARNING: GRUB update command not found. Please update GRUB manually."
                    fi
                else
                    echo "RT kernel parameters already present in GRUB configuration."
                fi
            else
                echo "WARNING: RT parameter file is empty."
            fi
        else
            echo "WARNING: RT parameter file not found at $RT_PARAM_FILE"
            echo "RT kernel installed without custom parameters."
        fi
    else
        echo "WARNING: /etc/default/grub not found. Cannot update kernel parameters."
    fi
fi

# Update GRUB to add new kernel to boot menu
if command -v update-grub >/dev/null 2>&1; then
    echo "Updating GRUB boot menu..."
    update-grub
elif command -v grub2-mkconfig >/dev/null 2>&1; then
    echo "Updating GRUB2 boot menu..."
    grub2-mkconfig -o /boot/grub2/grub.cfg
else
    echo "WARNING: GRUB update command not found. Please run 'sudo update-grub' manually."
fi

# Only run hooks if linux-run-hooks is available
if command -v linux-run-hooks >/dev/null 2>&1; then
    linux-run-hooks image postinst $version $image_path -- "$@"
fi

exit 0
