#!/bin/sh -e

version=@abiname@@localversion@
image_path=/boot/@image-stem@-$version

if [ "$1" != remove ]; then
    exit 0
fi

# Only run if linux-check-removal is available
if command -v linux-check-removal >/dev/null 2>&1; then
    linux-check-removal $version
fi

# Only run hooks if linux-run-hooks is available
if command -v linux-run-hooks >/dev/null 2>&1; then
    linux-run-hooks image prerm $version $image_path -- "$@"
fi

exit 0
