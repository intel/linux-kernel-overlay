Section: kernel
Priority: optional
Maintainer: Baoli Zhang <baoli.zhang@intel.com>
Standards-Version: 4.2.0
Build-Depends:
 debhelper-compat (= 13),
# used to run debian/bin/*.py
 python3:native,
 python3-dacite:native,
 python3-jinja2:native,
# used by debian/rules.real to prepare the source
 quilt,
# used by debian/rules.real to build linux-perf
 dh-python <!pkg.linux.notools>,
# used by kernel-wedge
 cpio <!pkg.linux.noudeb>,
Rules-Requires-Root: no
Homepage: https://www.kernel.org/
