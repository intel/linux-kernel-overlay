Package: linux@source_suffix@-headers@localversion@
Meta-Rules-Target: meta
Meta-Rules-Makeflags: INSTALLDOCS_LINK_DOC=linux@source_suffix@-base@localversion@
Build-Profiles: <!pkg.linux.nokernel !pkg.linux.nometa>
Depends:
 linux@source_suffix@-base@localversion@ (= ${binary:Version}),
 linux@source_suffix@-headers-@abiname@@localversion@ (= ${binary:Version}),
 ${misc:Depends},
Description: Header files for Linux @flavour@ configuration (meta-package)
 This package depends on the architecture-specific header files for the latest
 Linux kernel @flavour@ configuration.
